local function DecodeUnreliable()
	Decoding = -1
	local Index = buffer.readu8(RecieveBuffer, RecieveCursor)
	RecieveCursor += 1
	Decoding = Index
	if Index == 1 then
		local Value1: { { id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean } }?, Value2: number = SerdesFunctions.ReadEVENT_World()
		Value2 = UnwrapStamp(Value2)
		if StreamAccept(1, Value2) == true then
			local BOUND_LISTENER = Events.Unreliable[1]
			if BOUND_LISTENER ~= nil then
				SerdesEvent = "World"
				Decoding = -2 - Index
				BOUND_LISTENER(Value1, Value2)
			end
		end
	elseif Index == 2 then
		local Value1: { id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean }?, Value2: number = SerdesFunctions.ReadEVENT_Self()
		Value2 = UnwrapStamp(Value2)
		if StreamAccept(2, Value2) == true then
			local BOUND_LISTENER = Events.Unreliable[2]
			if BOUND_LISTENER ~= nil then
				SerdesEvent = "Self"
				Decoding = -2 - Index
				BOUND_LISTENER(Value1, Value2)
			end
		end
	elseif Index == 3 then
		local Value: { { id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean } } = SerdesFunctions.ReadEVENT_WorldState()
		local BOUND_LISTENER = Events.Unreliable[3]
		if BOUND_LISTENER ~= nil then
			SerdesEvent = "WorldState"
			Decoding = -2 - Index
			BOUND_LISTENER(Value)
		end
	elseif Index == 4 then
		local Value: { id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean } = SerdesFunctions.ReadEVENT_SelfState()
		local BOUND_LISTENER = Events.Unreliable[4]
		if BOUND_LISTENER ~= nil then
			SerdesEvent = "SelfState"
			Decoding = -2 - Index
			BOUND_LISTENER(Value)
		end
	else
		error("[BlinkBlox]: Unknown event index.")
	end
end
Reliable.OnClientEvent:Connect(function(Buffer: buffer, Instances: {Instance})
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstances = Instances
	RecieveInstanceCursor = 0
	local Size = buffer.len(RecieveBuffer)
	if SerdesThread and coroutine.status(SerdesThread) == "suspended" then
		warn(`[BlinkBlox]: Event "{SerdesEvent}" yielded in a Sync call, so the rest of the packet it arrived in was discarded. Use an Async call if the listener needs to yield.`)
		coroutine.close(SerdesThread)
	end
	SerdesThread = coroutine.running()
	Decoding = -1
	while true do
		local Parsed: boolean, Failure: any = pcall(DecodeLoop, DecodeReliable, Size)
		if Parsed then
			break
		end
		if Decoding > -2 then
			ReportDecodeFailure(EventNames.Reliable[Decoding], Failure)
			break
		end
		local Listening = EventNames.Reliable[-2 - Decoding]
		task.spawn(error, Failure, 0)
	end
end)
