function SerdesFunctions.ReadEVENT_Snapshot(): ({ id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean })
	-- Read BLOCK: 16 bytes
	local BLOCK_START = Read(16)
	local BITFIELD_1_0
	local RecieveBuffer = RecieveBuffer
	-- Value: Snapshot
	local Value = {id = false, x = false, y = false, z = false, health = false, moving = false, crouched = false} :: any
	-- Value.id: id
	Value.id = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	-- Value.x: x
	Value.x = buffer.readf32(RecieveBuffer, BLOCK_START + 2)
	-- Value.y: y
	Value.y = buffer.readf32(RecieveBuffer, BLOCK_START + 6)
	-- Value.z: z
	Value.z = buffer.readf32(RecieveBuffer, BLOCK_START + 10)
	-- Value.health: health
	Value.health = buffer.readu8(RecieveBuffer, BLOCK_START + 14)
	-- Value.moving: moving
	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 15)
	Value.moving = bit32.btest(BITFIELD_1_0, 0x01)
	-- Value.crouched: crouched
	Value.crouched = bit32.btest(BITFIELD_1_0, 0x02)
	return Value
end

function SerdesFunctions.WriteEVENT_Input(Value: { move: number, turn: number, jump: boolean, sprint: boolean }): ()
	-- Allocate BLOCK: 5 bytes
	local BLOCK_START = Allocate(5)
	local BITFIELD_1_0
	-- EVENT_Input (0)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 0)
	-- Value: Input
	-- Value.move: move
	buffer.writeu8(SendBuffer, BLOCK_START + 1, Value.move)
	-- Value.turn: turn
	buffer.writei16(SendBuffer, BLOCK_START + 2, Value.turn)
