	buffer.writeu16(SendBuffer, BLOCK_START + 2, Value2)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_WorldState(Value: { { id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean } }): ()
	-- Allocate BLOCK: 2 bytes
	local BLOCK_START = Allocate(2)
	-- EVENT_WorldState (3)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 3)
	-- Value: WorldState
	-- START ARRAY
	if not (#Value <= 16) then error(`Expected "#Value" to be smaller than or equal to 16, got {#Value} instead.`) end
	buffer.writeu8(SendBuffer, BLOCK_START + 1, #Value)
		-- Allocate BLOCK: 16 bytes
	local ARRAY_START_1 = Allocate(16 * #Value)
	local BITFIELD_2_0_OFFSET
	local BITFIELD_2_0
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		-- Item_1: WorldState
		do
			-- Item_1.id: id
			-- Allocate 2
			local OPERATION_OFFSET_0 = ARRAY_START_1
			ARRAY_START_1 += 2
			buffer.writeu16(SendBuffer, OPERATION_OFFSET_0, Item_1.id)
		end
		do
			-- Item_1.x: x
			-- Allocate 4
			local OPERATION_OFFSET_1 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_1, Item_1.x)
		end
		do
			-- Item_1.y: y
			-- Allocate 4
			local OPERATION_OFFSET_2 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_2, Item_1.y)
		end
		do
			-- Item_1.z: z
			-- Allocate 4
			local OPERATION_OFFSET_3 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_3, Item_1.z)
		end
		do
			-- Item_1.health: health
			-- Allocate 1
			local OPERATION_OFFSET_4 = ARRAY_START_1
			ARRAY_START_1 += 1
			buffer.writeu8(SendBuffer, OPERATION_OFFSET_4, Item_1.health)
		end
		do
			-- Item_1.moving: moving
			-- Allocate 1
			local OPERATION_OFFSET_5 = ARRAY_START_1
			ARRAY_START_1 += 1
			BITFIELD_2_0 = 0
			BITFIELD_2_0_OFFSET = OPERATION_OFFSET_5
			if Item_1.moving then BITFIELD_2_0 += 0x01 end
		end
		-- Item_1.crouched: crouched
		if Item_1.crouched then BITFIELD_2_0 += 0x02 end
		buffer.writeu8(SendBuffer, BITFIELD_2_0_OFFSET, BITFIELD_2_0)
	end
	-- END ARRAY
end

function SerdesFunctions.WriteEVENT_SelfState(Value: { id: number, x: number, y: number, z: number, health: number, moving: boolean, crouched: boolean }): ()
	-- Allocate BLOCK: 17 bytes
	local BLOCK_START = Allocate(17)
	local BITFIELD_1_0
	-- EVENT_SelfState (4)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 4)
	-- Value: SelfState
	-- Value.id: id
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.id)
	-- Value.x: x
	buffer.writef32(SendBuffer, BLOCK_START + 3, Value.x)
	-- Value.y: y
	buffer.writef32(SendBuffer, BLOCK_START + 7, Value.y)
	-- Value.z: z
	buffer.writef32(SendBuffer, BLOCK_START + 11, Value.z)
	-- Value.health: health
	buffer.writeu8(SendBuffer, BLOCK_START + 15, Value.health)
	-- Value.moving: moving
	BITFIELD_1_0 = 0
	if Value.moving then BITFIELD_1_0 += 0x01 end
	-- Value.crouched: crouched
	if Value.crouched then BITFIELD_1_0 += 0x02 end
	buffer.writeu8(SendBuffer, BLOCK_START + 16, BITFIELD_1_0)
end

