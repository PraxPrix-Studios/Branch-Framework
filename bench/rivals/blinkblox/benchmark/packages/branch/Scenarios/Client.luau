--!strict
--!native
--!optimize 2
--!nolint LocalShadow
--!nolint LocalUnused
--!nolint FunctionUnused
-- Branch Network (client) - generated by Branch Studio bench
-- 5 events, 2 to server, 3 to client
-- DO NOT EDIT: this module is rewritten on every network compile.
-- Declare events in your services: Service.Network = { Event = { From = ..., Data = ... } }
local bit32_btest = bit32.btest
local buffer_copy = buffer.copy
local buffer_create = buffer.create
local buffer_len = buffer.len
local buffer_readf32 = buffer.readf32
local buffer_readu16 = buffer.readu16
local buffer_readu8 = buffer.readu8
local buffer_writei16 = buffer.writei16
local buffer_writeu8 = buffer.writeu8
local math_max = math.max

local RunService = game:GetService("RunService")

local Root = script.Parent
local Reliable = Root:WaitForChild("Reliable") :: RemoteEvent
local Unreliable = Root:WaitForChild("Unreliable") :: UnreliableRemoteEvent

local CHECK = false
local BUDGET = 820
local QUEUE_LIMIT = 256
local INF = math.huge
local NAMES: { string } = {}
local READ: { any } = {}
local RUN: { any } = {} -- run readers: a run of one event in one call
local PENDING: { [number]: thread } = {}
local FAILED = newproxy()
local callCounter = 0
local DSEND: { any } = {} -- Delta: per event, what the server holds
local DRECV: { any } = {} -- Delta: per event, what the server sent last
local WRITE: { any } = {}
local LPA: { any } = {} -- Latest: the newest arguments, written at the flush
local LAS: { any } = {}
local LPK: { any } = {} -- Latest with Key: keys waiting for the flush
local GATE: { any } = {} -- Hz: seconds between sends
local GDUE: { any } = {}

-- Studio-only traffic counters for Branch (live). The BranchProfile attribute
-- on Branch.Network switches them while you Play (false = off: nothing is
-- counted or published). Never on in a live server.
local PROFILE_ALLOWED = false -- built without the Studio profiler
local PROFILE = false
local PROOT: any = Root
local SNAMES: { string } = {}
local PS_COUNT: { [number]: number } = {}
local PS_BYTES: { [number]: number } = {}
local PR_COUNT: { [number]: number } = {}
local PR_BYTES: { [number]: number } = {}
local PNUM: { [string]: { number } } = {}

local function psent(id: number, bytes: number)
	PS_COUNT[id] = (PS_COUNT[id] or 0) + 1
	PS_BYTES[id] = (PS_BYTES[id] or 0) + bytes
end

local function precv(id: number, bytes: number)
	PR_COUNT[id] = (PR_COUNT[id] or 0) + 1
	PR_BYTES[id] = (PR_BYTES[id] or 0) + bytes
end

local function pnum(id: number, field: string, v: any, declared: string, names: { string }?)
	if type(v) ~= "number" or v ~= v then
		return
	end
	local k = ((names or SNAMES)[id] or "?") .. "|" .. field
	local s = PNUM[k]
	if not s then
		PNUM[k] = { v, v, if v % 1 == 0 then 1 else 0, declared :: any }
		return
	end
	if v < s[1] then s[1] = v end
	if v > s[2] then s[2] = v end
	if v % 1 ~= 0 then s[3] = 0 end
end

local lastPublish = -1
local function publish()
	local now = os.clock()
	if now - lastPublish < 1 then
		return
	end
	lastPublish = now
	local out = {}
	for id, n in PS_COUNT do
		out[#out + 1] = `S|{SNAMES[id] or "?"}|{n}|{PS_BYTES[id]}`
	end
	for id, n in PR_COUNT do
		out[#out + 1] = `R|{NAMES[id] or "?"}|{n}|{PR_BYTES[id]}`
	end
	for k, s in PNUM do
		out[#out + 1] = `N|{k}|{s[1]}|{s[2]}|{s[3]}|{s[4]}`
	end
	PROOT:SetAttribute("BranchNetStatsClient", table.concat(out, "\n"))
end

local publishing: RBXScriptConnection? = nil
local function setProfile(on: boolean)
	if on == PROFILE then
		return
	end
	PROFILE = on
	if on then
		publishing = RunService.Heartbeat:Connect(publish)
	else
		if publishing then
			publishing:Disconnect()
			publishing = nil
		end
		table.clear(PS_COUNT)
		table.clear(PS_BYTES)
		table.clear(PR_COUNT)
		table.clear(PR_BYTES)
		table.clear(PNUM)
		lastPublish = -1
		PROOT:SetAttribute("BranchNetStatsClient", nil)
	end
end

if PROFILE_ALLOWED and PROOT.SetAttribute ~= nil then
	setProfile(PROOT:GetAttribute("BranchProfile") ~= false)
	PROOT:GetAttributeChangedSignal("BranchProfile"):Connect(function()
		setProfile(PROOT:GetAttribute("BranchProfile") ~= false)
	end)
end

local function fail(label: string, expected: string, value: any): never
	error(`Branch.Network: {label} expected {expected}, got {typeof(value)} ({tostring(value)})`, 3)
end

local function rvar(b: buffer, c: number, first: number): (number, number)
	local value = first - 128
	local scale = 128
	for _ = 1, 4 do
		local byte = buffer_readu8(b, c)
		c += 1
		if byte < 128 then
			return value + byte * scale, c
		end
		value += (byte - 128) * scale
		scale *= 128
	end
	error("varint too long", 0)
end

-- Send state: the stream currently being written. Stream 1 = reliable, 2 = unreliable.
local buf: buffer = buffer_create(0)
local cap = 0
local cur = 0
local refs: { any } = {}
local refn = 0
local evs: { number } = {} -- start of every event in the stream; negative = a run repeat
local evn = 0
local last = 0 -- id of the stream's last event (0: none); the same id next continues a run

local sBuf: { buffer } = { buffer_create(256), buffer_create(256) }
local sCap: { number } = { 256, 256 }
local sCur: { number } = { 0, 0 }
local sRefs: { { any } } = { {}, {} }
local sRefn: { number } = { 0, 0 }
local sEvs: { { number } } = { {}, {} }
local sEvn: { number } = { 0, 0 }
local sLast: { number } = { 0, 0 }
local uExtra, uRun = 0, 0 -- unreliable stream: bytes packing will add, trailing run length

local function grow(c: number, need: number): buffer
	local size = math_max(cap * 2, 256)
	while size < need do
		size *= 2
	end
	local b = buffer_create(size)
	buffer_copy(b, 0, buf, 0, c)
	buf = b
	cap = size
	return b
end

-- Runs: the writer stores a repeat of the previous event without its id (a
-- negative start marks one), so a run sits in the stream as [id][body][body]..
-- Shipping puts [0] and the count in front, [0][id][count][bodies]: one copy
-- per run. Runs shorter than 3, or whose bodies hold less than a byte per
-- event (the receiver's DoS bound: argument-less events), get their ids back.
-- Pass 1 sizes the output exactly, pass 2 writes it: one allocation, and a
-- frame without repeats is a single copy.
local runFrom: { number } = {}
local runTo: { number } = {}
local runHead: { boolean } = {}

local function pack(src: buffer, n: number, starts: { number }, count: number): buffer
	if count == 1 then
		-- one event: no runs to find, one exact copy
		local out = buffer_create(n)
		buffer_copy(out, 0, src, 0, n)
		return out
	end
	local runs = 0
	local size = n
	local i = 1
	while i <= count do
		local j = i
		while j < count and starts[j + 1] < 0 do
			j += 1
		end
		if j > i then
			local length = j - i + 1
			local stop = if j < count then starts[j + 1] else n
			local head = length >= 3 and stop - starts[i] >= 1 + length
			runs += 1
			runFrom[runs] = i
			runTo[runs] = j
			runHead[runs] = head
			if head then
				size += 1 + (if length < 128 then 1 elseif length < 16384 then 2 elseif length < 2097152 then 3 else 4)
			else
				size += (length - 1) * 1
			end
		end
		i = j + 1
	end
	local out = buffer_create(size)
	if runs == 0 then
		buffer_copy(out, 0, src, 0, n)
		return out
	end
	local o = 0
	local pending = 0
	for r = 1, runs do
		local from, to = runFrom[r], runTo[r]
		local first = starts[from]
		local stop = if to < count then starts[to + 1] else n
		if runHead[r] then
			if first > pending then
				buffer_copy(out, o, src, pending, first - pending)
				o += first - pending
			end
			buffer_writeu8(out, o, 0)
			buffer_writeu8(out, o + 1, buffer_readu8(src, first))
			o += 2 * 1
			local v = to - from + 1
			while v >= 128 do
				buffer_writeu8(out, o, v % 128 + 128)
				v //= 128
				o += 1
			end
			buffer_writeu8(out, o, v)
			o += 1
			local bodies = first + 1
			buffer_copy(out, o, src, bodies, stop - bodies)
			o += stop - bodies
		else
			local repeat1 = -starts[from + 1]
			if repeat1 > pending then
				buffer_copy(out, o, src, pending, repeat1 - pending)
				o += repeat1 - pending
			end
			local id = buffer_readu8(src, first)
			for k = from + 1, to do
				local bodyStart = -starts[k]
				local bodyEnd = if k < to then -starts[k + 1] else stop
				buffer_writeu8(out, o, id)
				o += 1
				if bodyEnd > bodyStart then
					buffer_copy(out, o, src, bodyStart, bodyEnd - bodyStart)
					o += bodyEnd - bodyStart
				end
			end
		end
		pending = stop
	end
	if pending < n then
		buffer_copy(out, o, src, pending, n - pending)
	end
	return out
end

-- Bytes packing adds back when a run grows to `length` events: its 2nd event
-- gets its id back (a run of 2 ships as two plain events), the 3rd turns it
-- into [0][id][count] (+1 for the count), and the count's varint grows.
local function runGrowth(length: number): number
	return if length == 2 then 1 elseif length == 3 or length == 128 or length == 16384 then 1 else 0
end

-- Moves the tail (events from index `first`, from byte `start`) to the front
-- once what came before it has shipped; refs and event starts follow. A tail
-- that repeats the event before it gets its id back: its run head is gone.
local function keepTail(start: number, refStart: number, first: number)
	local shift = start
	if evs[first] < 0 then
		local k = first - 1
		while evs[k] < 0 do
			k -= 1
		end
		local id = buffer_readu8(buf, evs[k])
		buffer_copy(buf, 1, buf, start, cur - start)
		buffer_writeu8(buf, 0, id)
		shift -= 1
	else
		buffer_copy(buf, 0, buf, start, cur - start)
	end
	cur -= shift
	if refStart > 0 then
		local remaining = refn - refStart
		table.move(refs, refStart + 1, refn, 1)
		for index = remaining + 1, refn do
			refs[index] = nil
		end
		refn = remaining
	end
	evs[1] = 0
	local count = 1
	for k = first + 1, evn do
		local e = evs[k]
		count += 1
		evs[count] = if e < 0 then e + shift else e - shift
	end
	evn = count
end

local openS = 0

local function writeBack()
	if openS ~= 0 then
		sBuf[openS], sCap[openS], sCur[openS], sRefn[openS], sEvn[openS], sLast[openS] = buf, cap, cur, refn, evn, last
		openS = 0
	end
end

local function openStream(s: number)
	if s ~= openS then
		writeBack()
		buf, cap, cur, refs, refn, evs, evn, last = sBuf[s], sCap[s], sCur[s], sRefs[s], sRefn[s], sEvs[s], sEvn[s], sLast[s]
		openS = s
	end
end

local function closeStream(_s: number) end

-- The budget counts what packing adds back to runs, so no packet goes over.
local function closeUnreliable(start: number, refStart: number)
	local run = if evs[evn] < 0 then uRun + 1 else 1
	local extra = uExtra + (if run > 1 then runGrowth(run) else 0)
	if start > 0 and cur + extra + refn * 8 > BUDGET then
		local headRefs = if refStart > 0 then table.move(refs, 1, refStart, 1, table.create(refStart)) else nil
		Unreliable:FireServer(pack(buf, start, evs, evn - 1), headRefs)
		keepTail(start, refStart, evn)
		run, extra = 1, 0
	end
	uRun, uExtra = run, extra
	closeStream(2)
end

-- Ships one stream now (end of frame, or right away for Invoke).
local function ship(s: number)
	local n = sCur[s]
	if n == 0 then
		return
	end
	local rn = sRefn[s]
	local out = pack(sBuf[s], n, sEvs[s], sEvn[s])
	local r = if rn > 0 then sRefs[s] else nil
	if s == 1 then
		Reliable:FireServer(out, r)
	else
		Unreliable:FireServer(out, r)
	end
	sCur[s] = 0
	sEvn[s] = 0
	sLast[s] = 0
	if s == 2 then
		uExtra, uRun = 0, 0
	end
	if rn > 0 then
		table.clear(sRefs[s])
		sRefn[s] = 0
	end
	if sCap[s] > 65536 and n < 8192 then
		sBuf[s] = buffer_create(8192)
		sCap[s] = 8192
	end
end

local function shipNow(s: number)
	writeBack()
	ship(s)
end

-- Latest events write their newest values here, just before the frame ships.
local PRE_FLUSH: { () -> () } = {}

local function flush()
	for index = 1, #PRE_FLUSH do
		PRE_FLUSH[index]()
	end
	writeBack()
	ship(1)
	ship(2)
end

RunService.Heartbeat:Connect(flush)

-- Receive -----------------------------------------------------------------

local EMPTY = table.freeze({})
local ERR = "malformed packet"

-- `st` (one per packet) = { c after the event being dispatched (-1 while
-- decoding), its ri, events left in the current run, the run's reader }:
-- a throwing Sync listener is reported and the rest of the packet still runs.
local function trace(message: any): { string }
	local text = tostring(message)
	return { text, debug.traceback(text, 2) }
end

local function process(b: buffer, r: { any }, len: number, st: { any }, c: number, ri: number)
	-- finish a run that a throwing listener cut short
	local left = st[3]
	if left > 0 then
		local runner = st[5]
		if runner then
			c, ri = runner(b, c, r, ri, st, left)
			st[5] = false
		else
			local reader = st[4]
			for index = left - 1, 0, -1 do
				st[3] = index
				c, ri = reader(b, c, r, ri, st)
			end
		end
		st[3] = 0
	end
	while c < len do
		local id = buffer_readu8(b, c)
		c += 1
		if id == 0 then
			id = buffer_readu8(b, c)
			c += 1
			local count = buffer_readu8(b, c)
			c += 1
			if count >= 128 then
				count, c = rvar(b, c, count)
			end
			local reader = READ[id]
			if reader == nil or count > len - c then
				error(`bad run of event {id}`, 0)
			end
			local bodies = c
			local runner = RUN[id]
			if runner then
				st[5] = runner
				c, ri = runner(b, c, r, ri, st, count)
				st[5] = false
			else
				st[4] = reader
				for index = count - 1, 0, -1 do
					st[3] = index
					c, ri = reader(b, c, r, ri, st)
				end
			end
			st[3] = 0
			if c - bodies < count then
				error(`bad run of event {id}`, 0)
			end
		else
			local reader = READ[id]
			if reader == nil then
				error(`unknown event id {id}`, 0)
			end
			c, ri = reader(b, c, r, ri, st)
		end
	end
end

local function receive(b: buffer, r: { any }?)
	local refs = r or EMPTY
	local len = buffer_len(b)
	local st = { -1, 0, 0, false, false }
	local c, ri = 0, 0
	while true do
		local ok, problem = xpcall(process, trace, b, refs, len, st, c, ri)
		if ok then
			return
		end
		c, ri = st[1], st[2]
		if c < 0 then
			warn(`Branch.Network: dropped the rest of a server packet: {problem[1]}`)
			return
		end
		-- a Sync listener threw: report it like any script error, keep the rest
		st[1] = -1
		task.spawn(error, problem[2], 0)
	end
end

local LS: { { (...any) -> () } } = {}
local ON: { (...any) -> () } = {}
local SPAWNS: { boolean } = {}
local Q: { { { n: number, [number]: any } } } = {}
local QWARNED: { boolean } = {}

-- Reused coroutine runner (spawning a fresh thread per event is the costly part).
local freeThread: thread? = nil

local function runHandler(fn: (...any) -> (), ...: any)
	local thread = freeThread
	freeThread = nil
	fn(...)
	freeThread = thread
end

local function runLoop()
	while true do
		runHandler(coroutine.yield())
	end
end

local function spawn(fn: (...any) -> (), ...: any)
	if not freeThread then
		freeThread = coroutine.create(runLoop)
		coroutine.resume(freeThread :: thread)
	end
	task.spawn(freeThread :: thread, fn, ...)
end

-- Keeps an event for the first listener; false when the queue is full.
local function enqueue(id: number, ...: any): boolean
	local queue = Q[id]
	if #queue >= QUEUE_LIMIT then
		if not QWARNED[id] then
			QWARNED[id] = true
			warn(`Branch.Network: {NAMES[id]} has no listener; dropping events past {QUEUE_LIMIT}`)
		end
		return false
	end
	queue[#queue + 1] = table.pack(...)
	return true
end

-- ON[id] is rebuilt whenever listeners change, so a received event costs one
-- index and one call: the lone Sync listener itself, a loop over a snapshot
-- (a listener that disconnects mid-event cannot skip its neighbour), a spawn
-- per listener for Async, or the queue while nobody listens.
local function rebuild(id: number)
	local listeners = table.clone(LS[id])
	local n = #listeners
	if n == 0 then
		ON[id] = function(...: any)
			enqueue(id, ...)
		end
	elseif SPAWNS[id] then
		ON[id] = function(...: any)
			for index = 1, n do
				spawn(listeners[index], ...)
			end
		end
	elseif n == 1 then
		ON[id] = listeners[1]
	else
		ON[id] = function(...: any)
			for index = 1, n do
				listeners[index](...)
			end
		end
	end
end

local function connect(id: number, fn: (...any) -> ()): () -> ()
	local listeners = LS[id]
	table.insert(listeners, fn)
	rebuild(id)
	local queue = Q[id]
	if #queue > 0 then
		Q[id] = {}
		for _, packed in queue do
			spawn(fn, table.unpack(packed, 1, packed.n))
		end
	end
	return function()
		local index = table.find(listeners, fn)
		if index then
			table.remove(listeners, index)
			rebuild(id)
		end
	end
end

local function nextCallId(): number
	for _ = 1, 65536 do
		callCounter = (callCounter + 1) % 65536
		if PENDING[callCounter] == nil then
			return callCounter
		end
	end
	error("Branch.Network: 65536 requests are already waiting for a reply", 3)
end

local function settle(label: string, first: any, ...: any): ...any
	if first == FAILED then
		error(`Branch.Network: {label} failed on the server`, 3)
	end
	return first, ...
end

-- Readers (server -> client) --------------------------------------------

-- Bench.SelfState
LS[1] = {}
Q[1] = {}
NAMES[1] = "Bench.SelfState"
rebuild(1)
READ[1] = function(b: buffer, c: number, r: { any }, ri: number, st: { any }): (number, number)
	local p0 = c
	local m_8 = buffer_readu8(b, c)
	local x_6 = bit32_btest(m_8, 1)
	local x_7 = bit32_btest(m_8, 2)
	local x_1 = buffer_readu16(b, c + 1)
	local x_2 = buffer_readf32(b, c + 3)
	local x_3 = buffer_readf32(b, c + 7)
	local x_4 = buffer_readf32(b, c + 11)
	local x_5 = buffer_readu8(b, c + 15)
	c += 16
	local a1 = { id = x_1, x = x_2, y = x_3, z = x_4, health = x_5, moving = x_6, crouched = x_7 }
	if PROFILE then precv(1, c - p0) end
	st[1], st[2] = c, ri
	ON[1](a1)
	st[1] = -1
	return c, ri
end
RUN[1] = function(b: buffer, c: number, r: { any }, ri: number, st: { any }, count: number): (number, number)
	for index = count - 1, 0, -1 do
		st[3] = index
		local p0 = c
		local m_16 = buffer_readu8(b, c)
		local x_14 = bit32_btest(m_16, 1)
		local x_15 = bit32_btest(m_16, 2)
		local x_9 = buffer_readu16(b, c + 1)
		local x_10 = buffer_readf32(b, c + 3)
		local x_11 = buffer_readf32(b, c + 7)
		local x_12 = buffer_readf32(b, c + 11)
		local x_13 = buffer_readu8(b, c + 15)
		c += 16
		local a1 = { id = x_9, x = x_10, y = x_11, z = x_12, health = x_13, moving = x_14, crouched = x_15 }
		if PROFILE then precv(1, c - p0) end
		st[1], st[2] = c, ri
		ON[1](a1)
		st[1] = -1
	end
	return c, ri
end

