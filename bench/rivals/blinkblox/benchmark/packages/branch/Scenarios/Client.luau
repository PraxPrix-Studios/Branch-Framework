	local p0 = c
	local m_24 = buffer_readu8(b, c)
	local x_22 = bit32_btest(m_24, 1)
	local x_23 = bit32_btest(m_24, 2)
	local x_17 = buffer_readu16(b, c + 1)
	local x_18 = buffer_readf32(b, c + 3)
	local x_19 = buffer_readf32(b, c + 7)
	local x_20 = buffer_readf32(b, c + 11)
	local x_21 = buffer_readu8(b, c + 15)
	c += 16
	local a1 = { id = x_17, x = x_18, y = x_19, z = x_20, health = x_21, moving = x_22, crouched = x_23 }
	if PROFILE then precv(2, c - p0) end
	st[1], st[2] = c, ri
	ON[2](a1)
	st[1] = -1
	return c, ri
end
RUN[2] = function(b: buffer, c: number, r: { any }, ri: number, st: { any }, count: number): (number, number)
	for index = count - 1, 0, -1 do
		st[3] = index
		local p0 = c
		local m_32 = buffer_readu8(b, c)
		local x_30 = bit32_btest(m_32, 1)
		local x_31 = bit32_btest(m_32, 2)
		local x_25 = buffer_readu16(b, c + 1)
		local x_26 = buffer_readf32(b, c + 3)
		local x_27 = buffer_readf32(b, c + 7)
		local x_28 = buffer_readf32(b, c + 11)
		local x_29 = buffer_readu8(b, c + 15)
		c += 16
