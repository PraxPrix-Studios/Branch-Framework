--!strict
--!native
--!optimize 2

--- Emits what is particular to a stamped event (docs/src/content/docs/language/stamps.mdx): on the
--- client, a `Fire` that takes the declared values and writes the stamp itself; on the server, the
--- line that turns the two-byte stamp into `SentAt`, clamped to the event's window. Everything else is
--- the event's own, generated by Event.luau from the wire type the parser gave it -- the declared
--- values with `SentAt: u16` appended.
local Blocks = require("./Blocks")
local Generators = require("./Generators")
local Parser = require("../Parser")
local State = require("./State")

local Parts = string.split(require("../Templates/Stamp"), "-- SPLIT --")

local Stamps = {}

--- The stamp runtime this module needs: the shared unwrap wherever a stamp is read or a stream sent,
--- and the clamp or the stamp on the side that uses it.
function Stamps.Runtime(): { string }
	local Runtime = {}
	if State.UsesStamps or State.UsesStreams then
		table.insert(Runtime, Parts[1])
	end

	if State.UsesStamps then
		table.insert(Runtime, Parts[if State.Context == "Server" then 2 else 3])
	end

	return Runtime
end

--- The stamp is the last of the positional values the receive branch decoded; the listener gets it as
--- the client's send time in seconds, held inside the window (ClampStamp in Templates/Stamp.luau).
function Stamps.Unwrap(Target: Blocks.Block, InnerArguments: string, Settings: Parser.StampSettings)
	State.UsesStamps = true
	local Positional = string.split(InnerArguments, ", ")
	local Stamp = Positional[#Positional]
	Target:Line(`{Stamp} = ClampStamp({Stamp}, {tostring(Settings.Window)})`)
end

--- The client's `Fire` for a stamped event: its parameters are the values the schema declared, and
--- the write appends the stamp to them. Returns the parameter list and the write's arguments.
function Stamps.Outgoing(Settings: Parser.StampSettings): (string, string)
	State.UsesStamps = true
	if not Settings.Value then
		return "", "StampNow()"
	end

	local _, Values, _, Arguments = Generators.LuauType(Settings.Value :: any, true)
	return Values, `{Arguments}, StampNow()`
end

return Stamps
