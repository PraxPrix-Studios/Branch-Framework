--!strict

local Parser = require("../Parser")
local Settings = require("../Settings")

local Lifecycle = require("./Lifecycle")
local Limits = require("./Limits")
local Prefabs = require("./Prefabs")
local Traffic = require("./Traffic")
local Util = require("./Util")

local Builder = require("../Modules/Builder")

type Type = Parser.TypeNode
type Scope = Parser.Scope
type Context = "Client" | "Server" | "Shared"
type AbstractSyntaxTree = Parser.Body

type State = {
	Scope: Scope,
	Indent: number,
	Casing: Settings.Cases,
	Builder: Builder.Builder,
	Context: Context,
	Options: Parser.Options,
}

local TESTING_HEADER =
	"type Instance = number\ntype Player = number\ntype CFrame = number\ntype Vector3 = number\ntype Color3 = number\ntype Sound = number\ntype buffer = number\n"
local VERSION_HEADER =
	`// File generated by BlinkBlox v{_G.VERSION or "0.0.0"} (https://github.com/XopoIII/BlinkBlox)\n// This file is not meant to be edited\n`

local Generators = {}
local Primitives = Prefabs.Primitives

local function GetPrefix(Indent: number): string
	return Indent == 0 and "declare " or ""
end

local function GetTypescriptType(State: State, Declaration: Type): (string, string)
	local Type = ""
	local Values = ""

	if Declaration.Type == "Primitive" then
		local Tokens = (Declaration :: Parser.Primitive).Tokens
		local Primitive = Primitives[Tokens.Primitive.Value]
		if type(Primitive.Type) == "function" then
			Type = Primitive.Type(Declaration :: Parser.Primitive)
		else
			Type = Primitive.Type
		end

		if Type == "any" then
			Type = "unknown"
		end
	elseif Declaration.Type == "Set" then
		Type = Util.SetType((Declaration :: Parser.Set).Value.Values)
	elseif Declaration.Type == "Enum" then
		local Value = (Declaration :: Parser.Enum).Value
		Type = Util.GenerateEnumLiterals(Value.Values)
	elseif Declaration.Type == "TagEnum" then
		local Value = (Declaration :: Parser.TagEnum).Value
		Type = Util.TagEnumType(Value.Tag, Value.Values, function(Variant)
			return (GetTypescriptType(State, Variant))
		end)
	elseif Declaration.Type == "Map" then
		local MapValue = (Declaration :: Parser.Map).Value
		local Key = GetTypescriptType(State, MapValue.Values[1])
		local Value = GetTypescriptType(State, MapValue.Values[2])
		Type = `Map<{Key}, {Value}>`
	elseif Declaration.Type == "Struct" then
		Type = Util.StructType(Declaration.Value.Values, function(Field)
			return (GetTypescriptType(State, Field))
		end, true)
	elseif Declaration.Type == "Generic" then
		Type = `{Declaration.Value.Generic}`
	elseif Declaration.Type == "Tuple" then
		local Value = (Declaration :: Parser.Tuple).Value
		local TupleValues = Value.Values

		local Types = {}
		local VariableTypes = {}

		--> A named element keeps its name here too, so the .d.ts parameter reads the same as the Luau
		--> one. An unnamed element stays positional.
		for Index, TupleValue in TupleValues do
			local Variable = Value.Names[Index] or `Value{Index}`
			local ValueType = GetTypescriptType(State, TupleValue)
			table.insert(Types, ValueType)
			table.insert(VariableTypes, `{Variable}: {ValueType}`)
		end

		Type = `{table.concat(Types, ", ")}`
		Values = table.concat(VariableTypes, ", ")
	elseif Declaration.Type == "Array" then
		local Value = Declaration.Value
		Type = `{GetTypescriptType(State, Value.Of)}[]`
	elseif Declaration.Type == "Optional" then
		local Value = Declaration.Value
		Type = `{GetTypescriptType(State, Value.Of)} | undefined`
	end

	--> Generalized type generation, works for everything except tuples
	if Declaration.Type ~= "Tuple" then
		Values = `Value: {Type}`
	else
		Type = `LuaTuple<[{Type}]>`
	end

	return Type, Values
end

function Generators.Type(State: State, Type: Type)
	local Name = Type.Name
	local Value = Type.Value

	local Indent = State.Indent
	local StringBuilder = State.Builder

	local TypescriptType = GetTypescriptType(State, Type)

	local Generics = Util.GenericsHeader(Value.Generics)

	StringBuilder.Push(`type {Name}{Generics} = {TypescriptType}`, 0, Indent)
end

function Generators.Export(State: State, Type: Type)
	local Name = Type.Name

	local Indent = State.Indent
	local Casing = State.Casing
	local StringBuilder = State.Builder

	local Types, Values = GetTypescriptType(State, Type)
	StringBuilder.Push(`{GetPrefix(Indent)}const {Name}: \{`, 0, Indent)
	StringBuilder.Push(`{Casing.Read}: (Buffer: buffer) => {Types}`, 0, Indent + 1)
	StringBuilder.Push(`{Casing.Write}: ({Values}) => buffer`, 0, Indent + 1)
	StringBuilder.Push(`\}`, 0, Indent)
end

function Generators.Function(State: State, Function: Parser.Function)
	local Name = Function.Name
	local Value = Function.Value

	local Indent = State.Indent
	local Casing = State.Casing
	local StringBuilder = State.Builder

	local _, Values = "void", "Value: void"
	if Value.Data then
		_, Values = GetTypescriptType(State, Value.Data)
	end

	local ReturnTypes = "void"
	if Value.Return then
		ReturnTypes = GetTypescriptType(State, Value.Return)
	end

	StringBuilder.Push(`export {GetPrefix(Indent)}const {Name}: \{`, 0, Indent)

	--> By DIRECTION. `From` names the side that invokes; the other side listens. Reading
	--> `State.Context == "Server"` was right only while the client was always the caller, and once a
	--> function could go the other way it produced the definitions exactly backwards -- `Invoke` on
	--> the side that listens.
	local IsCaller = (Value.From == State.Context)
	local Player = if State.Context == "Server" then "Player: Player, " else ""

	if not IsCaller then
		StringBuilder.Push(`{Casing.On}: (Listener: ({Player}{Values}) => {ReturnTypes}) => void`, 0, Indent + 1)
	else
		if Value.Yield == "Promise" then
			ReturnTypes = `Promise<{ReturnTypes}>`
		end

		StringBuilder.Push(`{Casing.Invoke}: ({Player}{Values}) => {ReturnTypes}`, 0, Indent + 1)
	end

	StringBuilder.Push(`\}`, 0, Indent)
end

function Generators.Event(State: State, Event: Parser.Event)
	local Name = Event.Name
	local Value = Event.Value

	local Indent = State.Indent
	local Casing = State.Casing
	local StringBuilder = State.Builder

	local IsPolling = not Value.Stream and not Value.Stamp and (Value.Call == "Polling" or State.Options.UsePolling)

	local _, Values = "", "Value: void"
	if Value.Data then
		_, Values = GetTypescriptType(State, Value.Data)
	end

	--> A stamped event's Fire takes the values the schema declared; the module appends the stamp.
	local FireValues = Values
	if Value.Stamp then
		FireValues = ""
		if Value.Stamp.Value then
			_, FireValues = GetTypescriptType(State, Value.Stamp.Value)
		end
	end

	local ListenerValues = Values
	if Value.From == "Client" then
		ListenerValues = `Player: Player, {Values}`
	end

	if IsPolling then
		ListenerValues = `Index: number, {ListenerValues}`
		ListenerValues = `LuaTuple<[{ListenerValues}]>`
	end

	StringBuilder.Push(`export {GetPrefix(Indent)}const {Name}: \{`, 0, Indent)

	if Value.From == State.Context then
		if Value.Stream then
			--> A stream's server sends on a schedule; the game hands it the state. The client listens to
			--> the wire type, `(Value: T | undefined, ServerTime: number)`, like any event.
			--> A `Per: Player` stream takes the player first in every member.
			local StreamType = GetTypescriptType(State, Value.Stream.Value)
			local Player = if Value.Stream.PerPlayer then "Player: Player" else ""
			local Before = if Value.Stream.PerPlayer then "Player: Player, " else ""
			StringBuilder.Push(`{Casing.Set}: ({Before}Value: {StreamType}) => void`, 0, Indent + 1)
			StringBuilder.Push(`{Casing.Clear}: ({Player}) => void`, 0, Indent + 1)
			StringBuilder.Push(`{Casing.Urgent}: ({Player}) => void`, 0, Indent + 1)
			StringBuilder.Push(`{Casing.SetFast}: ({Before}Fast: boolean) => void`, 0, Indent + 1)
		elseif Value.From == "Server" then
			StringBuilder.Push(`{Casing.Fire}: (Player: Player, {Values}) => void`, 0, Indent + 1)
			StringBuilder.Push(`{Casing.FireAll}: ({Values}) => void`, 0, Indent + 1)
			StringBuilder.Push(`{Casing.FireExcept}: (Except: Player, {Values}) => void`, 0, Indent + 1)
			StringBuilder.Push(`{Casing.FireList}: (List: Player[], {Values}) => void`, 0, Indent + 1)
		else
			StringBuilder.Push(`{Casing.Fire}: ({FireValues}) => void`, 0, Indent + 1)
		end
	elseif IsPolling then
		StringBuilder.Push(`{Casing.Iter}: () => IterableFunction<{ListenerValues}>`, 0, Indent + 1)
	else
		StringBuilder.Push(`{Casing.On}: (Listener: ({ListenerValues}) => void) => (() => void)`, 0, Indent + 1)

		--> Predict takes what a listener receives, since it stands in for an arriving event.
		if State.Options.Predict then
			StringBuilder.Push(`{Casing.Predict}: ({ListenerValues}) => void`, 0, Indent + 1)
		end
	end

	StringBuilder.Push(`\}`, 0, Indent)
end

function Generators.Scope(State: State, Scope: Parser.ScopeNode)
	local Name = Scope.Name
	local Value = Scope.Value

	local Parent = State.Scope
	local Indent = State.Indent
	local StringBuilder = State.Builder

	State.Indent += 1
	State.Scope = Value.Scope

	StringBuilder.Push(`export {GetPrefix(Indent)}namespace {Name} \{`, 0, Indent)
	Generators.Tree(State, Value.Values)
	StringBuilder.Push(`}`, 0, Indent)

	State.Indent -= 1
	State.Scope = Parent
end

function Generators.Tree(State: State, Tree: { Parser.Declaration })
	for _, Declaration in Tree do
		if Declaration.Type == "Scope" then
			Generators.Scope(State, Declaration :: Parser.ScopeNode)
		elseif Declaration.Type == "Event" then
			Generators.Event(State, Declaration :: Parser.Event)
		elseif Declaration.Type == "Function" then
			Generators.Function(State, Declaration :: Parser.Function)
		else
			if Declaration.Value.Export then
				Generators.Export(State, Declaration :: Type)
			end

			Generators.Type(State, Declaration :: Type)
		end
	end
end

--- The module members that install the game's handlers, typed as the Luau module types them. The
--- client's rate-limit, packet-drop and listener-error setters take the server's handler type and
--- ignore it, so code shared between the two sides can install one without branching.
local DROP_REASON = `"Malformed" | "Oversized" | "Budget" | "Instances" | "Events"`

local function HandlerDeclarations(FileContext: Context, Casing: Settings.Cases): { string }
	local Decode = if FileContext == "Server"
		then "(player: Player, event: string | undefined, failure: string) => void"
		else "(event: string | undefined, failure: string) => void"

	return {
		`export declare const {Casing.SetRateLimitHandler}: (handler?: (player: Player, event: string | undefined, refused: number) => void) => void`,
		`export declare const {Casing.SetDecodeErrorHandler}: (handler?: {Decode}) => void`,
		`export declare const {Casing.SetPacketDropHandler}: (handler?: (player: Player, reason: {DROP_REASON}, refused: number, detail: number) => void) => void`,
		`export declare const {Casing.SetListenerErrorHandler}: (handler?: (player: Player, event: string, failure: string, count: number) => void) => void`,
	}
end

return function(FileContext: Context, AbstractSyntaxTree: AbstractSyntaxTree): string
	local Options = AbstractSyntaxTree.Value.Options
	local Casing = Settings.GetCasing(Options.Casing or "Pascal" :: any)
	local StringBuilder = Builder.new()

	StringBuilder.Push(VERSION_HEADER)
	StringBuilder.Push(`export declare const {Casing.StepReplication}: () => void`)
	for _, Line in HandlerDeclarations(FileContext, Casing) do
		StringBuilder.Push(Line)
	end
	if FileContext ~= "Shared" then
		for _, Line in Traffic.Typescript(Options, Casing) do
			StringBuilder.Push(Line)
		end
	end

	--> The members Generator/Lifecycle adds, under the same conditions.
	StringBuilder.Push(
		`export declare const {Casing.Remotes}: \{ readonly Reliable: string; readonly Unreliable: string }`
	)
	if Lifecycle.Bounded(FileContext, Options) then
		StringBuilder.Push(`export declare const {Casing.Connected}: boolean`)
	end
	if Lifecycle.Deferred(FileContext, Options) then
		StringBuilder.Push(`export declare const {Casing.Start}: () => void`)
	end

	if Options.ExportLimits then
		local Word = Limits.Words(Options.Casing :: Settings.Case?)
		local Limit = Limits.Declarations(AbstractSyntaxTree.Value.Declarations, Word)
		StringBuilder.Push(`export declare const {Word("Limits")}: {Limits.Typescript(Limit, Word)}`)
	end

	if _G.VERSION == nil then
		StringBuilder.Push(TESTING_HEADER)
	end

	local State: State = {
		Scope = nil :: any,
		Indent = 0,
		Casing = Casing,
		Context = FileContext,
		Options = Options,
		Builder = StringBuilder,
	}

	Generators.Tree(State, AbstractSyntaxTree.Value.Declarations)

	return table.concat(StringBuilder.DumpLines())
end
