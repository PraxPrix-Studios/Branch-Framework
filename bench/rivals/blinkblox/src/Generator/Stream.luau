--!strict
--!native
--!optimize 2

--- Emits what is particular to a stream (docs/src/content/docs/language/streams.mdx): on the server,
--- the scheduler entry, the send it calls and the members the game drives it with; on the client, the
--- line that turns the two-byte stamp back into seconds. Everything else -- the serialisers, the
--- receive branch, the listener API -- is the event's own, generated by Event.luau from the wire type
--- the parser gave it, `(Value: T?, ServerTime: u16)`.
local Blocks = require("./Blocks")
local Builder = require("../Modules/Builder")
local Generators = require("./Generators")
local Outbound = require("./Outbound")
local Parser = require("../Parser")
local Sends = require("./Send")
local State = require("./State")
local Writes = require("./Writes")

local Streams = {}

--- The stamp is the last of the positional values the receive branch decoded; the listener gets it as
--- the server time in seconds, the one nearest the client's own server clock (UnwrapStamp in
--- Templates/Stream.luau).
function Streams.Unwrap(Block: Blocks.Block, InnerArguments: string): string
	State.UsesStreams = true
	local Positional = string.split(InnerArguments, ", ")
	local Stamp = Positional[#Positional]
	Block:Line(`{Stamp} = UnwrapStamp({Stamp})`)
	return Stamp
end

--- A number as the generated code writes it: Luau's shortest spelling that reads back the same.
local function Literal(Value: number): string
	return tostring(Value)
end

--- The server's half of a stream. `Values` and `WriteEvent` are the wire type's parameter list and
--- the call that serialises it, as Event.luau spells them for the Fire family this replaces.
--- `Counters` is where the event's traffic counters start under `option TrafficStats`: a scheduled
--- send is counted as a FireList would be, once per recipient, on the event and the unreliable channel.
function Streams.Server(
	Declaration: Parser.Event,
	Index: number,
	Values: string,
	WriteEvent: string,
	Body: Builder.Builder,
	Indent: number,
	Counters: number?
)
	local Settings = assert(Declaration.Value.Stream, "a stream's settings")
	local Casing = State.Casing
	local Name = Declaration.Name
	local Stream = `STREAM_{Index}`

	State.UsesStreams = true

	--> Every player the same packet, in one FireAllClients: a stream is ordered by the server time it
	--> carries, not by a sequence number per player. A `Per: Player` stream sends each player's own
	--> state to that player alone.
	local Outgoing: Sends.Send = {
		IsReliable = false,
		WriteEvent = WriteEvent,
		Name = Name,
		Traffic = Counters,
		Stream = true,
		PerPlayer = Settings.PerPlayer == true,
		Instances = Writes.CarriesInstances(Declaration.Value.Data),
		Low = Outbound.Low(Declaration.Value.Priority),
	}
	local PerPlayer = Settings.PerPlayer
	local Send = if PerPlayer
		then Sends.One(Blocks.Function(`Send{Stream}`, `Player: Player, {Values}`, "()", false, true), Outgoing):End()
		else Sends.Broadcast(
			Blocks.Function(`Send{Stream}`, Values, "()", false, true),
			Outgoing,
			"Players:GetPlayers()",
			{ AllClients = true }
		)

	--> The intervals stay written as the rates they come from, `1 / 10` rather than 0.1.
	local Interval = `1 / {Literal(Settings.Rate)}`
	local Fast = if Settings.Fast then `1 / {Literal(Settings.Fast)}` else Interval
	local Each = if PerPlayer then ", each player" else ""
	State.Streams.Push(
		`\n-- {Name}: {Settings.Rate} a second{if Settings.Fast then `, {Settings.Fast} fast` else ""}{Each}`
	)
	State.Streams.PushLines(Send.Content, 0)
	State.Streams.Push(
		`local {Stream} = {if PerPlayer then "CreatePlayerStream" else "CreateStream"}("{Name}", {Interval}, {Fast}, {Literal(
			Settings.Keepalive
		)}, {Literal(Settings.Epsilon)}, Send{Stream})`
	)
	if PerPlayer and Outgoing.Low then
		State.Streams.Push(`OutboundLow[{Stream}] = true`)
	end

	local Type = Generators.LuauType(Settings.Value, true)
	local Members: { string } = if PerPlayer
		then {
			`{Casing.Set} = function(Player: Player, Value: {Type}): () PlayerStreamSet({Stream}, Player, Value) end,`,
			`{Casing.Clear} = function(Player: Player): () PlayerStreamClear({Stream}, Player) end,`,
			`{Casing.Urgent} = function(Player: Player): () PlayerStreamUrgent({Stream}, Player) end,`,
			`{Casing.SetFast} = function(Player: Player, Fast: boolean): () PlayerStreamSetFast({Stream}, Player, Fast) end,`,
		}
		else {
			`{Casing.Set} = function(Value: {Type}): () StreamSet({Stream}, Value) end,`,
			`{Casing.Clear} = function(): () StreamClear({Stream}) end,`,
			`{Casing.Urgent} = function(): () {Stream}.Urgent = true end,`,
			`{Casing.SetFast} = function(Fast: boolean): () {Stream}.Fast = Fast end,`,
		}

	for _, Member in Members do
		Body.Push(Member, 0, Indent + 1)
	end

	State.Noop.PushLines({
		`{Casing.Set} = NOOP,\n`,
		`{Casing.Clear} = NOOP,\n`,
		`{Casing.Urgent} = NOOP,\n`,
		`{Casing.SetFast} = NOOP\n`,
	}, 0, Indent + 1)
end

return Streams
