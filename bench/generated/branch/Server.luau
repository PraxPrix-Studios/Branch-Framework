--!strict
--!native
--!optimize 2
--!nolint LocalShadow
--!nolint LocalUnused
--!nolint FunctionUnused
-- Branch Network (server) - generated by Branch Studio bench
-- 6 events, 4 to server, 2 to client
-- DO NOT EDIT: this module is rewritten on every network compile.
-- Declare events in your services: Service.Network = { Event = { From = ..., Data = ... } }
local Vector3_new = Vector3.new
local bit32_btest = bit32.btest
local bit32_lshift = bit32.lshift
local buffer_copy = buffer.copy
local buffer_create = buffer.create
local buffer_len = buffer.len
local buffer_readf64 = buffer.readf64
local buffer_readstring = buffer.readstring
local buffer_readu16 = buffer.readu16
local buffer_readu8 = buffer.readu8
local buffer_writef32 = buffer.writef32
local buffer_writeu16 = buffer.writeu16
local buffer_writeu8 = buffer.writeu8
local math_floor = math.floor
local math_max = math.max
local math_min = math.min
local math_random = math.random
local math_sqrt = math.sqrt

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- This module lives in ServerScriptService, so players never download it.
-- Root is Branch.Network in ReplicatedStorage, where the remotes are.
local rootRef = (script :: any):FindFirstChild("Root")
local Root: any = if rootRef then rootRef.Value else script.Parent
local Reliable = Root:WaitForChild("Reliable") :: RemoteEvent
local Unreliable = Root:WaitForChild("Unreliable") :: UnreliableRemoteEvent

local CHECK = false
local IS_STUDIO = RunService:IsStudio()
local BUDGET = 820
local MAX_PACKET = 65536
local KICK_AFTER = 0 -- forged packets before a kick (0 = never)
local QUEUE_LIMIT = 256
local INF = math.huge
local NAMES: { string } = {}
local RESPONSE_ID: { number } = {}
local READ_R: { any } = table.create(4)
local READ_U: { any } = table.create(4)
local RUN_R: { any } = table.create(4) -- run readers: a run of one event in one call
local RUN_U: { any } = table.create(4)
local HANDLERS: { any } = {}
local RESPOND: { any } = {}
local DSEND: { any } = {} -- Delta: per event, per player, what they hold
local DRECV: { any } = {} -- Delta: per event, per player, what they sent last
local WRITE: { any } = {}
local WRITEALL: { any } = {}
local STORE: { any } = {} -- Latest: keep the newest arguments until the flush
local LPA: { any } = {}
local LPS: { any } = {}
local LAA: { any } = {}
local LAS: { any } = {}
local LPK: { any } = {} -- Latest with Key: per player, the keys waiting for the flush
local GATE: { any } = {} -- Hz / Lod: seconds between sends, per ring (and per key group)
local GDUE: { any } = {}
local GPHASE: { any } = {} -- where on its time grid each gate opens
local LOD: { any } = {} -- Lod: ring distances

-- Studio-only traffic counters for Branch (live). The BranchProfile attribute
-- on Branch.Network switches them while you Play (false = off: nothing is
-- counted or published). Never on in a live server.
-- Only what readers and writers touch stays at the top (a module has room for
-- 200 locals); the rest lives in the block below.
local PROFILE = false
local SNAMES: { string } = {}
local psent: (id: number, bytes: number) -> ()
local precv: (id: number, bytes: number) -> ()
local pnum: (id: number, field: string, v: any, declared: string, names: { string }?) -> ()
do
	local PROFILE_ALLOWED = false -- built without the Studio profiler
	local PROOT: any = Root
	local PS_COUNT: { [number]: number } = {}
	local PS_BYTES: { [number]: number } = {}
	local PR_COUNT: { [number]: number } = {}
	local PR_BYTES: { [number]: number } = {}
	local PNUM: { [string]: { number } } = {}

	function psent(id: number, bytes: number)
		PS_COUNT[id] = (PS_COUNT[id] or 0) + 1
		PS_BYTES[id] = (PS_BYTES[id] or 0) + bytes
	end

	function precv(id: number, bytes: number)
		PR_COUNT[id] = (PR_COUNT[id] or 0) + 1
		PR_BYTES[id] = (PR_BYTES[id] or 0) + bytes
	end

	function pnum(id: number, field: string, v: any, declared: string, names: { string }?)
		if type(v) ~= "number" or v ~= v then
			return
		end
		local k = ((names or SNAMES)[id] or "?") .. "|" .. field
		local s = PNUM[k]
		if not s then
			PNUM[k] = { v, v, if v % 1 == 0 then 1 else 0, declared :: any }
			return
		end
		if v < s[1] then s[1] = v end
		if v > s[2] then s[2] = v end
		if v % 1 ~= 0 then s[3] = 0 end
	end

	local lastPublish = -1
	local function publish()
		local now = os.clock()
		if now - lastPublish < 1 then
			return
		end
		lastPublish = now
		local out = {}
		for id, n in PS_COUNT do
			out[#out + 1] = `S|{SNAMES[id] or "?"}|{n}|{PS_BYTES[id]}`
		end
		for id, n in PR_COUNT do
			out[#out + 1] = `R|{NAMES[id] or "?"}|{n}|{PR_BYTES[id]}`
		end
		for k, s in PNUM do
			out[#out + 1] = `N|{k}|{s[1]}|{s[2]}|{s[3]}|{s[4]}`
		end
		PROOT:SetAttribute("BranchNetStatsServer", table.concat(out, "\n"))
	end

	local publishing: RBXScriptConnection? = nil
	local function setProfile(on: boolean)
		if on == PROFILE then
			return
		end
		PROFILE = on
		if on then
			publishing = RunService.Heartbeat:Connect(publish)
		else
			if publishing then
				publishing:Disconnect()
				publishing = nil
			end
			table.clear(PS_COUNT)
			table.clear(PS_BYTES)
			table.clear(PR_COUNT)
			table.clear(PR_BYTES)
			table.clear(PNUM)
			lastPublish = -1
			PROOT:SetAttribute("BranchNetStatsServer", nil)
		end
	end

	if PROFILE_ALLOWED and PROOT.SetAttribute ~= nil then
		setProfile(PROOT:GetAttribute("BranchProfile") ~= false)
		PROOT:GetAttributeChangedSignal("BranchProfile"):Connect(function()
			setProfile(PROOT:GetAttribute("BranchProfile") ~= false)
		end)
	end
end

-- FireNear: players whose character's PrimaryPart is within `radius`.
local near: (position: Vector3, radius: number) -> { Player }
do
	local nearList: { Player } = {}
	function near(position: Vector3, radius: number): { Player }
		table.clear(nearList)
		for _, player in Players:GetPlayers() do
			local character = (player :: any).Character
			local root = character and character.PrimaryPart
			if root and (root.Position - position).Magnitude <= radius then
				nearList[#nearList + 1] = player
			end
		end
		return nearList
	end
end

local function rvar(b: buffer, c: number, first: number): (number, number)
	local value = first - 128
	local scale = 128
	for _ = 1, 4 do
		local byte = buffer_readu8(b, c)
		c += 1
		if byte < 128 then
			return value + byte * scale, c
		end
		value += (byte - 128) * scale
		scale *= 128
	end
	error("varint too long", 0)
end

-- the 8 booleans of every byte value, for decoding boolean arrays
local BOOL_ROWS: { { boolean } } = table.create(256)
for byteValue = 0, 255 do
	local row = table.create(8)
	for bit = 0, 7 do
		row[bit + 1] = bit32_btest(byteValue, bit32_lshift(1, bit))
	end
	BOOL_ROWS[byteValue + 1] = table.freeze(row)
end

-- Rows or bit tests for boolean arrays: whichever this VM runs faster (bit
-- tests natively, rows interpreted). Timed once, about 50 microseconds.
local ROWS_WIN = (function(): boolean
	local probe = buffer_create(128)
	for index = 0, 127 do
		buffer_writeu8(probe, index, (index * 37 + 11) % 256)
	end
	local target = table.create(1024, false)
	local bitsTime, rowsTime = math.huge, math.huge
	for _ = 1, 6 do
		local t0 = os.clock()
		for k = 0, 127 do
			local byte = buffer_readu8(probe, k)
			local j = k * 8
			target[j + 1] = bit32_btest(byte, 1)
			target[j + 2] = bit32_btest(byte, 2)
			target[j + 3] = bit32_btest(byte, 4)
			target[j + 4] = bit32_btest(byte, 8)
			target[j + 5] = bit32_btest(byte, 16)
			target[j + 6] = bit32_btest(byte, 32)
			target[j + 7] = bit32_btest(byte, 64)
			target[j + 8] = bit32_btest(byte, 128)
		end
		local t1 = os.clock()
		for k = 0, 127 do
			table.move(BOOL_ROWS[buffer_readu8(probe, k) + 1], 1, 8, k * 8 + 1, target)
		end
		local t2 = os.clock()
		bitsTime = math_min(bitsTime, t1 - t0)
		rowsTime = math_min(rowsTime, t2 - t1)
	end
	return rowsTime < bitsTime
end)()

-- Send state: the stream currently being written.
local buf: buffer = buffer_create(0)
local cap = 0
local cur = 0
local refs: { any } = {}
local refn = 0
local evs: { number } = {} -- start of every event in the stream; negative = a run repeat
local evn = 0
local last = 0 -- id of the stream's last event (0: none); the same id next continues a run

-- Per-stream storage (Structure of Arrays). Player slot k owns stream
-- 2k - 1 (reliable) and 2k (unreliable).
local sBuf: { buffer } = {}
local sCap: { number } = {}
local sCur: { number } = {}
local sRefs: { { any } } = {}
local sRefn: { number } = {}
local sEvs: { { number } } = {}
local sEvn: { number } = {}
local sLast: { number } = {}
local sExtra: { number } = {} -- unreliable: bytes packing will add (for the budget)
local sRun: { number } = {} -- unreliable: length of the trailing run
local sDirty: { boolean } = {}
local slotPlayer: { Player } = {}
local slotOf: { [Player]: number } = {}
local freeSlots: { number } = {}
local slotCount = 0
local dirty: { number } = {}
local dirtyCount = 0

-- Scratch for FireList / FireExcept: serialised once, copied to each recipient.
local xBuf = buffer_create(256)
local xCap = 256
local xRefs: { any } = {}
local xEvs: { number } = {}

local function grow(c: number, need: number): buffer
	local size = math_max(cap * 2, 256)
	while size < need do
		size *= 2
	end
	local b = buffer_create(size)
	buffer_copy(b, 0, buf, 0, c)
	buf = b
	cap = size
	return b
end

-- Runs: the writer stores a repeat of the previous event without its id (a
-- negative start marks one), so a run sits in the stream as [id][body][body]..
-- Shipping puts [0] and the count in front, [0][id][count][bodies]: one copy
-- per run. Runs shorter than 3, or whose bodies hold less than a byte per
-- event (the receiver's DoS bound: argument-less events), get their ids back.
-- Pass 1 sizes the output exactly, pass 2 writes it: one allocation, and a
-- frame without repeats is a single copy.
local runFrom: { number } = {}
local runTo: { number } = {}
local runHead: { boolean } = {}

local function pack(src: buffer, n: number, starts: { number }, count: number): buffer
	if count == 1 then
		-- one event: no runs to find, one exact copy
		local out = buffer_create(n)
		buffer_copy(out, 0, src, 0, n)
		return out
	end
	local runs = 0
	local size = n
	local i = 1
	while i <= count do
		local j = i
		while j < count and starts[j + 1] < 0 do
			j += 1
		end
		if j > i then
			local length = j - i + 1
			local stop = if j < count then starts[j + 1] else n
			local head = length >= 3 and stop - starts[i] >= 1 + length
			runs += 1
			runFrom[runs] = i
			runTo[runs] = j
			runHead[runs] = head
			if head then
				size += 1 + (if length < 128 then 1 elseif length < 16384 then 2 elseif length < 2097152 then 3 else 4)
			else
				size += (length - 1) * 1
			end
		end
		i = j + 1
	end
	local out = buffer_create(size)
	if runs == 0 then
		buffer_copy(out, 0, src, 0, n)
		return out
	end
	local o = 0
	local pending = 0
	for r = 1, runs do
		local from, to = runFrom[r], runTo[r]
		local first = starts[from]
		local stop = if to < count then starts[to + 1] else n
		if runHead[r] then
			if first > pending then
				buffer_copy(out, o, src, pending, first - pending)
				o += first - pending
			end
			buffer_writeu8(out, o, 0)
			buffer_writeu8(out, o + 1, buffer_readu8(src, first))
			o += 2 * 1
			local v = to - from + 1
			while v >= 128 do
				buffer_writeu8(out, o, v % 128 + 128)
				v //= 128
				o += 1
			end
			buffer_writeu8(out, o, v)
			o += 1
			local bodies = first + 1
			buffer_copy(out, o, src, bodies, stop - bodies)
			o += stop - bodies
		else
			local repeat1 = -starts[from + 1]
			if repeat1 > pending then
				buffer_copy(out, o, src, pending, repeat1 - pending)
				o += repeat1 - pending
			end
			local id = buffer_readu8(src, first)
			for k = from + 1, to do
				local bodyStart = -starts[k]
				local bodyEnd = if k < to then -starts[k + 1] else stop
				buffer_writeu8(out, o, id)
				o += 1
				if bodyEnd > bodyStart then
					buffer_copy(out, o, src, bodyStart, bodyEnd - bodyStart)
					o += bodyEnd - bodyStart
				end
			end
		end
		pending = stop
	end
	if pending < n then
		buffer_copy(out, o, src, pending, n - pending)
	end
	return out
end

-- Bytes packing adds back when a run grows to `length` events: its 2nd event
-- gets its id back (a run of 2 ships as two plain events), the 3rd turns it
-- into [0][id][count] (+1 for the count), and the count's varint grows.
local function runGrowth(length: number): number
	return if length == 2 then 1 elseif length == 3 or length == 128 or length == 16384 then 1 else 0
end

-- Moves the tail (events from index `first`, from byte `start`) to the front
-- once what came before it has shipped; refs and event starts follow. A tail
-- that repeats the event before it gets its id back: its run head is gone.
local function keepTail(start: number, refStart: number, first: number)
	local shift = start
	if evs[first] < 0 then
		local k = first - 1
		while evs[k] < 0 do
			k -= 1
		end
		local id = buffer_readu8(buf, evs[k])
		buffer_copy(buf, 1, buf, start, cur - start)
		buffer_writeu8(buf, 0, id)
		shift -= 1
	else
		buffer_copy(buf, 0, buf, start, cur - start)
	end
	cur -= shift
	if refStart > 0 then
		local remaining = refn - refStart
		table.move(refs, refStart + 1, refn, 1)
		for index = remaining + 1, refn do
			refs[index] = nil
		end
		refn = remaining
	end
	evs[1] = 0
	local count = 1
	for k = first + 1, evn do
		local e = evs[k]
		count += 1
		evs[count] = if e < 0 then e + shift else e - shift
	end
	evn = count
end

local function slot(player: Player): number?
	local k = slotOf[player]
	if k then
		return k
	end
	if player.Parent ~= Players then
		return nil
	end
	k = table.remove(freeSlots)
	if not k then
		slotCount += 1
		k = slotCount
		for s = 2 * k - 1, 2 * k do
			sBuf[s] = buffer_create(256)
			sCap[s] = 256
			sCur[s] = 0
			sRefs[s] = {}
			sRefn[s] = 0
			sEvs[s] = {}
			sEvn[s] = 0
			sLast[s] = 0
			sExtra[s] = 0
			sRun[s] = 0
			sDirty[s] = false
		end
	end
	slotOf[player] = k
	slotPlayer[k] = player
	return k
end

-- FireAll arenas: while only FireAll writes to a channel, its events pile up
-- here once and ship as ONE FireAllClients per frame (serialised once, one
-- engine call). The first per-player write on that channel "materialises"
-- the arena into every recipient's stream, so per-player order is exact.
local bBuf: { buffer } = { buffer_create(256), buffer_create(256) }
local bCap: { number } = { 256, 256 }
local bCur: { number } = { 0, 0 }
local bRefs: { { any } } = { {}, {} }
local bRefn: { number } = { 0, 0 }
local bEvs: { { number } } = { {}, {} }
local bEvn: { number } = { 0, 0 }
local bLast: { number } = { 0, 0 }
local aExtra, aRun = 0, 0 -- the unreliable arena's budget bookkeeping (like sExtra / sRun)
local bPlayers: { { Player } } = { {}, {} } -- recipients at the first FireAll of the batch
local bRoster: { number } = { 0, 0 }
local roster = 0 -- bumps on every join/leave

-- Write-back cache: the stream being written stays in the upvalues above
-- until another stream is opened (or the frame flushes), so consecutive
-- fires to one player, or consecutive FireAlls, cost a single comparison
-- instead of a dozen table ops. openS > 0 is a player stream, -c the FireAll
-- arena of channel c, 0 nothing.
local openS = 0

local function writeBack()
	local s = openS
	if s > 0 then
		sBuf[s], sCap[s], sCur[s], sRefn[s], sEvn[s], sLast[s] = buf, cap, cur, refn, evn, last
	elseif s < 0 then
		s = -s
		bBuf[s], bCap[s], bCur[s], bRefn[s], bEvn[s], bLast[s] = buf, cap, cur, refn, evn, last
	end
	openS = 0
end

-- Pending single events: a player's first event of the frame, when it has a fixed size of at
-- most 256 bytes and no Instances, goes straight into a buffer of exactly its size, kept here
-- while the stream itself stays empty (and is not the open one). A frame that sends nothing
-- else to that stream ships the buffer as it is. Anything else written to the stream first
-- moves it in (promote), so the stream holds exactly what it always did.
local pend: { buffer? } = {}

local function promote(s: number)
	local b = pend[s] :: buffer
	pend[s] = nil
	local n = buffer_len(b)
	buffer_copy(sBuf[s], 0, b, 0, n) -- a stream's buffer never holds less than 256 bytes
	sCur[s], sEvn[s] = n, 1
	sLast[s] = if n > 1 then buffer_readu8(b, 0) else 0 -- an id alone never repeats
	sEvs[s][1] = 0
	sRun[s], sExtra[s] = 1, 0
end

local function openStream(s: number)
	if s ~= openS then
		writeBack()
		if pend[s] then
			promote(s)
		end
		buf, cap, cur, refs, refn, evs, evn, last = sBuf[s], sCap[s], sCur[s], sRefs[s], sRefn[s], sEvs[s], sEvn[s], sLast[s]
		openS = s
	end
end

local function closeStream(s: number)
	if not sDirty[s] then
		sDirty[s] = true
		dirtyCount += 1
		dirty[dirtyCount] = s
	end
end

local function openScratch()
	writeBack()
	buf, cap, cur, refs, refn, evs, evn, last = xBuf, xCap, 0, xRefs, 0, xEvs, 0, 0
end

local function closeScratch(): (buffer, number, number, number)
	xBuf, xCap = buf, cap
	return buf, cur, refn, last
end

local function headRefs(refStart: number): { any }?
	return if refStart > 0 then table.move(refs, 1, refStart, 1, table.create(refStart)) else nil
end

-- Unreliable packets above the budget are dropped by Roblox, so an event that
-- would overflow the pending batch ships the batch first.
-- The budget counts what packing adds back to runs, so no packet goes over.
local function closeUnreliable(s: number, start: number, refStart: number)
	local run = if evs[evn] < 0 then sRun[s] + 1 else 1
	local extra = sExtra[s] + (if run > 1 then runGrowth(run) else 0)
	if start > 0 and cur + extra + refn * 8 > BUDGET then
		Unreliable:FireClient(slotPlayer[(s + 1) // 2], pack(buf, start, evs, evn - 1), headRefs(refStart))
		keepTail(start, refStart, evn)
		run, extra = 1, 0
	end
	sRun[s], sExtra[s] = run, extra
	closeStream(s)
end

-- Copies a serialised block (an arena, or one FireList event) into stream s.
-- The block opens with a full event; on a reliable stream whose last event is
-- the same one, that id is dropped so the run carries on across the join.
-- Unreliable blocks stay whole (their budget bookkeeping travels with them).
local function append(s: number, src: buffer, n: number, srcRefs: { any }, srcRefn: number, srcEvs: { number }, srcEvn: number, srcLast: number, srcExtra: number, srcRun: number)
	openStream(s)
	local unreliable = s % 2 == 0
	local start, refStart, first = cur, refn, evn + 1
	local skip = if not unreliable and last ~= 0 and buffer_readu8(src, 0) == last then 1 else 0
	local c = cur
	if c + n - skip > cap then
		grow(c, c + n - skip)
	end
	buffer_copy(buf, c, src, skip, n - skip)
	cur = c + n - skip
	if srcRefn > 0 then
		table.move(srcRefs, 1, srcRefn, refn + 1, refs)
		refn += srcRefn
	end
	local shift = c - skip
	evn += 1
	evs[evn] = if skip > 0 then -c else c
	for index = 2, srcEvn do
		local e = srcEvs[index]
		evn += 1
		evs[evn] = if e < 0 then e - shift else e + shift
	end
	last = srcLast
	if unreliable then
		local extra = sExtra[s] + srcExtra
		if start > 0 and cur + extra + refn * 8 > BUDGET then
			Unreliable:FireClient(slotPlayer[(s + 1) // 2], pack(buf, start, evs, first - 1), headRefs(refStart))
			keepTail(start, refStart, first)
			extra = srcExtra
		end
		sExtra[s], sRun[s] = extra, srcRun
	end
	closeStream(s)
end

local function materialize(c: number)
	local n, rn, en, srcLast = bCur[c], bRefn[c], bEvn[c], bLast[c]
	bCur[c], bRefn[c], bEvn[c], bLast[c] = 0, 0, 0, 0
	local srcExtra, srcRun = 0, 0
	if c == 2 then
		srcExtra, srcRun, aExtra, aRun = aExtra, aRun, 0, 0
	end
	local src, srcRefs, srcEvs = bBuf[c], bRefs[c], bEvs[c]
	for _, player in bPlayers[c] do
		local k = slotOf[player] or slot(player)
		if k then
			append(2 * k - 2 + c, src, n, srcRefs, rn, srcEvs, en, srcLast, srcExtra, srcRun)
		end
	end
	if rn > 0 then
		table.clear(srcRefs)
	end
end

-- Stream index for a per-player write on channel c (1 reliable, 2 unreliable).
local function target(player: Player, c: number): number?
	if openS < 0 then
		writeBack()
	end
	if bCur[c] > 0 then
		materialize(c)
	end
	local k = slotOf[player] or slot(player)
	if not k then
		return nil
	end
	return 2 * k - 2 + c
end

local function openBroadcast(c: number)
	if openS ~= -c then
		writeBack()
		buf, cap, cur, refs, refn, evs, evn, last = bBuf[c], bCap[c], bCur[c], bRefs[c], bRefn[c], bEvs[c], bEvn[c], bLast[c]
		openS = -c
	end
	if cur == 0 then
		bPlayers[c] = Players:GetPlayers()
		bRoster[c] = roster
	end
end

local function shipBroadcast(c: number, out: buffer, r: { any }?)
	local remote: any = if c == 1 then Reliable else Unreliable
	if bRoster[c] == roster then
		remote:FireAllClients(out, r)
	else
		-- someone joined or left since the first FireAll: keep exact recipients
		for _, player in bPlayers[c] do
			if player.Parent == Players then
				remote:FireClient(player, out, r)
			end
		end
	end
end

local function broadcast(src: buffer, n: number, rn: number, srcLast: number, offset: number, players: { Player }, except: Player?)
	local c = 2 - offset
	if openS < 0 then
		writeBack()
	end
	if bCur[c] > 0 then
		materialize(c)
	end
	for _, player in players do
		if player ~= except then
			local k = slotOf[player] or slot(player)
			if k then
				append(2 * k - offset, src, n, xRefs, rn, xEvs, 1, srcLast, 0, 1)
			end
		end
	end
	if rn > 0 then
		table.clear(xRefs)
	end
end

-- Ships one stream now (end of frame, or right away for function replies).
local function ship(s: number)
	local single = pend[s]
	if single then
		-- the stream is empty while one is pending: the single is all there is
		pend[s] = nil
		if s % 2 == 1 then
			Reliable:FireClient(slotPlayer[(s + 1) // 2], single)
		else
			Unreliable:FireClient(slotPlayer[(s + 1) // 2], single)
		end
		return
	end
	local n = sCur[s]
	if n == 0 then
		return
	end
	local rn = sRefn[s]
	local out = pack(sBuf[s], n, sEvs[s], sEvn[s])
	local player = slotPlayer[(s + 1) // 2]
	if s % 2 == 1 then
		Reliable:FireClient(player, out, if rn > 0 then sRefs[s] else nil)
	else
		Unreliable:FireClient(player, out, if rn > 0 then sRefs[s] else nil)
	end
	sCur[s] = 0
	sEvn[s] = 0
	sLast[s] = 0
	sExtra[s] = 0
	sRun[s] = 0
	if rn > 0 then
		table.clear(sRefs[s])
		sRefn[s] = 0
	end
	-- Give back memory after a burst.
	if sCap[s] > 65536 and n < 8192 then
		sBuf[s] = buffer_create(8192)
		sCap[s] = 8192
	end
end

local function shipNow(s: number)
	writeBack()
	ship(s)
end

-- Only the unreliable arena needs closing: it ships early before the budget.
-- Unreliable events queued for single players before this FireAll go first,
-- or the early ship would overtake them.
local function closeBroadcast(start: number, refStart: number)
	local run = if evs[evn] < 0 then aRun + 1 else 1
	local extra = aExtra + (if run > 1 then runGrowth(run) else 0)
	if start > 0 and cur + extra + refn * 8 > BUDGET then
		for index = 1, dirtyCount do
			local s = dirty[index]
			if s % 2 == 0 then
				ship(s)
			end
		end
		shipBroadcast(2, pack(buf, start, evs, evn - 1), headRefs(refStart))
		keepTail(start, refStart, evn)
		run, extra = 1, 0
	end
	aRun, aExtra = run, extra
end

-- Latest events write their newest values here, just before the frame ships.
local PRE_FLUSH: { () -> () } = {}

local function flush()
	for index = 1, #PRE_FLUSH do
		PRE_FLUSH[index]()
	end
	writeBack()
	for index = 1, dirtyCount do
		local s = dirty[index]
		sDirty[s] = false
		local single = pend[s]
		if single then
			pend[s] = nil
			if s % 2 == 1 then
				Reliable:FireClient(slotPlayer[(s + 1) // 2], single)
			else
				Unreliable:FireClient(slotPlayer[(s + 1) // 2], single)
			end
			continue
		end
		local n = sCur[s]
		if n > 0 and sEvn[s] == 1 and sRefn[s] == 0 then
			-- one event, no Instances (the common case of state sent to each
			-- player): one exact copy, sent, and the stream is empty again
			local out = buffer_create(n)
			buffer_copy(out, 0, sBuf[s], 0, n)
			if s % 2 == 1 then
				Reliable:FireClient(slotPlayer[(s + 1) // 2], out)
			else
				Unreliable:FireClient(slotPlayer[(s + 1) // 2], out)
				sExtra[s], sRun[s] = 0, 0
			end
			sCur[s], sEvn[s], sLast[s] = 0, 0, 0
		else
			ship(s)
		end
	end
	dirtyCount = 0
	-- FireAll arenas go last: they only hold events fired after every
	-- per-player event already flushed above.
	for c = 1, 2 do
		local n = bCur[c]
		if n > 0 then
			local rn = bRefn[c]
			shipBroadcast(c, pack(bBuf[c], n, bEvs[c], bEvn[c]), if rn > 0 then bRefs[c] else nil)
			bCur[c] = 0
			bEvn[c] = 0
			bLast[c] = 0
			if c == 2 then
				aExtra, aRun = 0, 0
			end
			if rn > 0 then
				table.clear(bRefs[c])
				bRefn[c] = 0
			end
			if bCap[c] > 65536 and n < 8192 then
				bBuf[c] = buffer_create(8192)
				bCap[c] = 8192
			end
		end
	end
end

Players.PlayerAdded:Connect(function()
	roster += 1
end)

Players.PlayerRemoving:Connect(function(player: Player)
	roster += 1
	local k = slotOf[player]
	if not k then
		return
	end
	if openS == 2 * k - 1 or openS == 2 * k then
		openS = 0 -- discard: nothing more goes to this player
	end
	slotOf[player] = nil
	for s = 2 * k - 1, 2 * k do
		pend[s] = nil
		sCur[s] = 0
		sRefn[s] = 0
		sEvn[s] = 0
		sLast[s] = 0
		sExtra[s] = 0
		sRun[s] = 0
		table.clear(sRefs[s])
	end
	table.insert(freeSlots, k)
end)

RunService.Heartbeat:Connect(flush)

-- Receive -----------------------------------------------------------------

local EMPTY = table.freeze({})
local ERR = "malformed packet"
local BAD = "bad value"
local rejectHandlers: { (Player, string, boolean) -> () } = {}
-- Anticheat.Restrict / a level: every refused request counts as forged, rate limits refill slower
local RESTRICTED: { [Player]: boolean } = {}

-- Strikes: a packet no Branch client can produce (wrong remote arguments, an
-- empty packet, an unknown event, a broken structure) is forged, and after
-- KICK_AFTER of them the player is kicked (0 = never). A bad value, a rate
-- limit or a guard can also come from the game's own bug or from lag, so those
-- are only reported (OnReject's third argument tells them apart).
local rejected: (player: Player, reason: any, forged: boolean) -> ()
do
	local STRIKES: { [Player]: number } = {}
	Players.PlayerRemoving:Connect(function(p: Player)
		STRIKES[p] = nil
	end)

	function rejected(player: Player, reason: any, forged: boolean)
		forged = forged or RESTRICTED[player] == true
		local text = tostring(reason)
		if IS_STUDIO then
			warn(`Branch.Network rejected a packet from {player.Name}: {text}{if forged then " (forged)" else ""}`)
		end
		for _, handler in rejectHandlers do
			task.spawn(handler, player, text, forged)
		end
		if forged and KICK_AFTER > 0 then
			local strikes = (STRIKES[player] or 0) + 1
			STRIKES[player] = strikes
			if strikes == KICK_AFTER then
				player:Kick("The server refused data from your client.")
			end
		end
	end
end

-- Anticheat findings: Branch's own checks (heartbeat, silence, raw, tamper,
-- strict), the ready-made ones a game turns on (speed, teleport, fly, noclip),
-- the game's client checks (Anticheat.Check / Report) and its server ones
-- (Anticheat.Flag). Every finding:
--   * is kept in the player's record (score, count per check, the last 50),
--     which admin panels read (GetFlagged, GetRecord, OnChanged);
--   * does what SetAction says for its check: "kick" (from the `after`-th
--     finding on), "report" or "ignore";
--   * adds the check's weight to the player's score, and each level the score
--     reaches (SetLevel) acts once: "restrict", "kick" or a function.
-- Kicks never happen in Studio, nor with KICK_AFTER = 0. OnFlag and OnReject
-- ("anticheat: ...") hear every finding that is not ignored.
-- (a function, not a do block: its many locals do not count against the
-- module's 200)
local flag: (p: Player, check: string, detail: string?, once: boolean?) -> ()
local anticheatApi: any = (function()
	-- Basic, the default: a finding of a check that kicks kicks; no levels.
	local BASIC_ACTIONS = { strict = "report" }
	local BASIC_AFTER = { speed = 4, teleport = 4, fly = 4, noclip = 4 }
	local WEIGHTS: { [string]: number } = {
		heartbeat = 10, silence = 10, raw = 10, tamper = 10, strict = 1,
		speed = 2, teleport = 3, fly = 3, noclip = 2,
	}
	local ACTIONS: { [string]: string } = table.clone(BASIC_ACTIONS)
	local AFTER: { [string]: number } = table.clone(BASIC_AFTER)
	local DEFAULT_ACTION = "kick" -- of a check SetAction never named
	local LEVELS: { { at: number, action: any } } = {} -- by score, low to high
	local DECAY = 0 -- score points a minute
	local kickMessage = "The server refused data from your client."
	local flagHandlers: { (Player, string, string?, number) -> () } = {}
	local changeHandlers: { (Player, any) -> () } = {}
	-- per player: { score, scoredAt, levels reached, checks = { [check] = { count, detail, at } }, history }
	local RECORDS: { [Player]: any } = {}
	local KICKED: { [Player]: boolean } = {}

	local function decayed(record: any, now: number)
		if DECAY > 0 then
			record.score = math_max(0, record.score - DECAY * (now - record.scoredAt) / 60)
		end
		record.scoredAt = now
	end

	-- What panels get: a copy, so nothing they do reaches the anticheat.
	local function snapshot(p: Player, record: any): any
		decayed(record, os.clock())
		local checks = {}
		for name, entry in record.checks do
			checks[name] = table.freeze({ count = entry.count, detail = entry.detail, at = entry.at })
		end
		return table.freeze({
			player = p,
			score = record.score,
			restricted = RESTRICTED[p] == true,
			checks = table.freeze(checks),
			history = table.freeze(table.clone(record.history)),
		})
	end

	local shareChanged: ((p: Player, record: any?) -> ())? = nil -- set while sharing across servers

	local function changed(p: Player, record: any?)
		if changeHandlers[1] then
			local view = if record then snapshot(p, record) else nil
			for _, handler in changeHandlers do
				task.spawn(handler, p, view)
			end
		end
		if shareChanged then
			shareChanged(p, record)
		end
	end

	local function kick(p: Player)
		if KICK_AFTER > 0 and not IS_STUDIO and not KICKED[p] then
			KICKED[p] = true
			p:Kick(kickMessage)
		end
	end

	Players.PlayerRemoving:Connect(function(p: Player)
		KICKED[p] = nil
		RESTRICTED[p] = nil
		if RECORDS[p] then
			RECORDS[p] = nil
			changed(p, nil)
		end
	end)

	-- once: Branch's own checks speak once per player and check
	function flag(p: Player, check: string, detail: string?, once: boolean?)
		local record = RECORDS[p]
		if once and record and record.checks[check] then
			return
		end
		local action = ACTIONS[check] or DEFAULT_ACTION
		if action == "ignore" then
			return
		end
		local now = os.clock()
		if not record then
			record = { score = 0, scoredAt = now, reached = 0, checks = {}, history = {} }
			RECORDS[p] = record
		end
		local entry = record.checks[check]
		if not entry then
			entry = { count = 0, detail = nil, at = 0 }
			record.checks[check] = entry
		end
		local at = os.time()
		entry.count += 1
		entry.detail = detail
		entry.at = at
		local history = record.history
		if #history >= 50 then
			table.remove(history, 1)
		end
		table.insert(history, table.freeze({ check = check, detail = detail, at = at }))
		decayed(record, now)
		record.score += WEIGHTS[check] or 1
		local text = if detail then `{check}: {detail}` else check
		local after = AFTER[check] or 1
		local kicks = action == "kick" and entry.count >= after and KICK_AFTER > 0
		if IS_STUDIO then
			local note = if kicks then " (never kicked in Studio)" elseif action == "kick" and entry.count < after then ` ({entry.count} of {after} before a kick)` else ""
			warn(`Branch anticheat: {p.Name}: {text}{note}`)
		end
		for _, handler in flagHandlers do
			task.spawn(handler, p, check, detail, record.score)
		end
		for _, handler in rejectHandlers do
			task.spawn(handler, p, "anticheat: " .. text, kicks)
		end
		-- the levels the score just reached, each once
		for index = record.reached + 1, #LEVELS do
			local level = LEVELS[index]
			if record.score < level.at then
				break
			end
			record.reached = index
			local act = level.action
			if act == "restrict" then
				RESTRICTED[p] = true
			elseif act == "kick" then
				kicks = KICK_AFTER > 0
			else
				task.spawn(act, p, snapshot(p, record))
			end
		end
		changed(p, record)
		if kicks then
			kick(p)
		end
	end

	-- Ready-made checks (Anticheat.Use), off until a game turns one on. The
	-- server samples every character twice a second, spread over the frames,
	-- and judges what it sees: the player's own client moves the character,
	-- so it can lie, but not in ways that look like walking.
	local MOVE_DEFAULTS = {
		speed = { max = 0, tolerance = 1.75 }, -- max 0: the Humanoid's WalkSpeed
		teleport = { distance = 100 },
		fly = { height = 16, time = 4 },
		noclip = {},
	}
	local MOVE: { [string]: any } = {}
	local MOVERS: { Player } = {}
	local STATE: { [Player]: any } = {}
	local PAUSED: { [Player]: number } = {}
	Players.PlayerRemoving:Connect(function(p: Player)
		PAUSED[p] = nil -- Pause works before Use too
	end)
	local INTERVAL = 0.5
	local credit, cursor = 0, 0
	local moving = false

	local function one(x: number): string
		return string.format("%.1f", x)
	end

	-- The state of a player's current character (a new character starts anew,
	-- with 3 s before it is judged).
	local function stateOf(p: Player, now: number): any
		local character = (p :: any).Character
		local s = STATE[p]
		if s and s.character == character then
			return s
		end
		if s and s.moved then
			s.moved:Disconnect()
		end
		s = { character = character, quiet = now + 3, fast = 0, air = 0, clips = 0, clipAt = 0, step = 0, stepTime = 0, at = now }
		if character then
			s.root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
			s.humanoid = character:FindFirstChildOfClass("Humanoid")
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character }
			params.RespectCanCollide = true
			s.params = params
			if s.root then
				-- a script of the game moved the character (a teleport, a spawn
				-- point): not the player's doing (physics does not fire this)
				s.moved = s.root:GetPropertyChangedSignal("CFrame"):Connect(function()
					s.quiet = math_max(s.quiet, os.clock() + 1)
				end)
			end
		end
		STATE[p] = s
		return s
	end

	local function sample(p: Player, now: number)
		local s = stateOf(p, now)
		local root, humanoid = s.root, s.humanoid
		if not root or not humanoid or root.Parent == nil then
			return
		end
		local pos = root.Position
		local last, dt = s.pos, now - s.at
		s.pos, s.at = pos, now
		if
			last == nil
			or dt <= 0
			or now < s.quiet
			or now < (PAUSED[p] or 0)
			or humanoid.Health <= 0
			or humanoid.SeatPart ~= nil
			or humanoid.PlatformStand
			or root.Anchored
		then
			-- not walking on its own: seated, on a platform, dead, held, just moved by the game
			s.fast, s.air, s.step, s.stepTime = 0, 0, 0, 0
			return
		end
		local d = pos - last
		local flat = math_sqrt(d.X * d.X + d.Z * d.Z)
		-- the server may see a jump spread over two samples: judge the pair too
		local pair, pairTime = flat + s.step, dt + s.stepTime
		s.step, s.stepTime = flat, dt
		local speed, teleport = MOVE.speed, MOVE.teleport
		if speed or teleport then
			local allowed = (if speed and speed.max > 0 then speed.max else humanoid.WalkSpeed) * (if speed then speed.tolerance else 1.75) + 4
			if teleport and (pair > math_max(teleport.distance, allowed * pairTime * 3) or d.Y > teleport.distance) then
				flag(p, "teleport", `{math_floor(math_max(pair, d.Y))} studs in {one(pairTime)} s`)
				s.fast, s.step, s.stepTime = 0, 0, 0
			elseif speed and flat / dt > allowed then
				-- three samples in a row: a lag burst is one or two
				s.fast += 1
				if s.fast >= 3 then
					flag(p, "speed", `{math_floor(flat / dt)} studs/s, {math_floor(allowed)} allowed`)
					s.fast = 0
				end
			else
				s.fast = 0
			end
		end
		local fly = MOVE.fly
		if fly then
			-- in the air without falling: no ground under it and not coming down
			if d.Y / dt > -8 and workspace:Raycast(pos, Vector3_new(0, -fly.height, 0), s.params) == nil then
				s.air += dt
				if s.air >= fly.time then
					flag(p, "fly", `{one(s.air)} s in the air`)
					s.air = 0
				end
			else
				s.air = 0
			end
		end
		if MOVE.noclip and flat > 0.5 then
			-- the path since the last sample goes through something solid; three
			-- times in 10 s is a finding (once or twice can be doors that just closed)
			local hit = workspace:Raycast(last, d, s.params)
			if hit then
				s.clips = if now - s.clipAt > 10 then 1 else s.clips + 1
				s.clipAt = now
				if s.clips >= 3 then
					flag(p, "noclip", `through {hit.Instance.Name}`)
					s.clips = 0
				end
			end
		end
	end

	local function startMoving()
		if moving then
			return
		end
		moving = true
		for _, p in Players:GetPlayers() do
			table.insert(MOVERS, p)
		end
		Players.PlayerAdded:Connect(function(p: Player)
			table.insert(MOVERS, p)
		end)
		Players.PlayerRemoving:Connect(function(p: Player)
			local index = table.find(MOVERS, p)
			if index then
				MOVERS[index] = MOVERS[#MOVERS]
				MOVERS[#MOVERS] = nil
			end
			local s = STATE[p]
			if s and s.moved then
				s.moved:Disconnect()
			end
			STATE[p] = nil
		end)
		RunService.Heartbeat:Connect(function(dt: number)
			local count = #MOVERS
			if count == 0 then
				return
			end
			-- each player twice a second, a few per frame
			credit += count * dt / INTERVAL
			local now = os.clock()
			for _ = 1, math_min(math_floor(credit), count) do
				cursor = cursor % count + 1
				sample(MOVERS[cursor], now)
			end
			credit -= math_floor(credit)
		end)
	end

	-- Across servers (ShareAcrossServers). Every server publishes what changed in
	-- its players' records on one MessagingService topic, a few seconds' worth at
	-- a time and well under 1 KB a message, and keeps what the others publish.
	-- Wire: { j = JobId, p = PlaceId, e = { { userId, name, score, restricted,
	-- "check=count,..." } or { userId } (gone) }, h = true (a new server: "send
	-- me everything") }. An entry is dropped when its server says the player is
	-- gone (left, pardoned, server closing) or stops refreshing it (crashed).
	local TOPIC = "BranchAnticheat"
	local SHARE_EVERY = 3 -- seconds between publishes of what changed
	local REFRESH_EVERY = 60 -- everything again, for servers that came later
	local FORGET_AFTER = 150 -- an entry nobody refreshed for this long
	local JOB = if game.JobId ~= "" then game.JobId else "studio"
	local DIRTY: { [Player]: boolean } = {} -- emptied on every publish
	local GLOBAL: { [string]: any } = {} -- "job:userId" -> other servers' entries
	local globalHandlers: { (number, any) -> () } = {}
	local subscription: any = nil
	local sharing, shareAt, refreshAt, closing = false, 0, 0, false

	-- what an entry looks like to the game (frozen)
	local function entryOf(userId: number, name: string, score: number, restricted: boolean, checks: { [string]: number }, server: string, place: number, here: boolean): any
		return table.freeze({
			userId = userId,
			name = name,
			score = score,
			restricted = restricted,
			checks = table.freeze(checks),
			server = server,
			placeId = place,
			here = here,
		})
	end

	local function localEntry(p: Player, record: any): any
		local checks = {}
		for name, entry in record.checks do
			checks[name] = entry.count
		end
		decayed(record, os.clock())
		return entryOf((p :: any).UserId, p.Name, record.score, RESTRICTED[p] == true, checks, JOB, game.PlaceId, true)
	end

	local function tellGlobal(userId: number, entry: any?)
		for _, handler in globalHandlers do
			task.spawn(handler, userId, entry)
		end
	end

	-- one player on the wire: { userId } when gone
	local function wireOf(p: Player): { any }
		local record = RECORDS[p]
		if not record or closing then
			return { (p :: any).UserId }
		end
		decayed(record, os.clock())
		local parts, count = {}, 0
		for name, entry in record.checks do
			count += 1
			if count > 12 then
				break
			end
			parts[count] = `{string.sub(name, 1, 24)}={entry.count}`
		end
		return { (p :: any).UserId, string.sub(p.Name, 1, 20), math_floor(record.score * 10 + 0.5) / 10, if RESTRICTED[p] then 1 else 0, table.concat(parts, ",") }
	end

	local function publish(data: any)
		task.spawn(function()
			local ok, problem = pcall(function()
				game:GetService("MessagingService"):PublishAsync(TOPIC, data)
			end)
			if not ok and IS_STUDIO then
				warn(`Branch anticheat: sharing across servers failed: {problem}`)
			end
		end)
	end

	-- publishes these players, a message per ~800 bytes
	local function share(players: { Player })
		local batch, size = {}, 0
		for _, p in players do
			local wire = wireOf(p)
			local bytes = 24 + (if wire[2] then #wire[2] + #wire[5] + 24 else 0)
			if size + bytes > 800 and batch[1] then
				publish({ j = JOB, p = game.PlaceId, e = batch })
				batch, size = {}, 0
			end
			table.insert(batch, wire)
			size += bytes
		end
		if batch[1] then
			publish({ j = JOB, p = game.PlaceId, e = batch })
		end
	end

	local function received(message: any)
		local data = type(message) == "table" and message.Data
		if type(data) ~= "table" or type(data.j) ~= "string" or data.j == JOB then
			return
		end
		if data.h then
			-- a server that just started: everything soon, not every server at once
			local at = os.clock() + math_random() * 2
			refreshAt = math_min(refreshAt, at)
			shareAt = math_min(shareAt, at)
		end
		if type(data.e) ~= "table" then
			return
		end
		local now = os.clock()
		for _, wire in data.e do
			local userId = type(wire) == "table" and wire[1]
			if type(userId) ~= "number" then
				continue
			end
			local key = `{data.j}:{userId}`
			if wire[2] == nil then
				if GLOBAL[key] then
					GLOBAL[key] = nil
					tellGlobal(userId, nil)
				end
			elseif type(wire[2]) == "string" and type(wire[3]) == "number" and type(wire[5]) == "string" then
				local checks = {}
				for name, count in string.gmatch(wire[5], "([^,=]+)=(%d+)") do
					checks[name] = tonumber(count)
				end
				local entry = entryOf(userId, wire[2], wire[3], wire[4] == 1, checks, data.j, if type(data.p) == "number" then data.p else 0, false)
				GLOBAL[key] = { entry = entry, seen = now }
				tellGlobal(userId, entry)
			end
		end
	end

	local function shareTick()
		local now = os.clock()
		if now >= refreshAt then
			refreshAt = now + REFRESH_EVERY
			for p in RECORDS do
				DIRTY[p] = true
			end
			for key, held in GLOBAL do
				if now - held.seen > FORGET_AFTER then
					GLOBAL[key] = nil
					tellGlobal(held.entry.userId, nil)
				end
			end
		end
		if now >= shareAt and next(DIRTY) then
			shareAt = now + SHARE_EVERY
			local players = {}
			for p in DIRTY do
				table.insert(players, p)
			end
			table.clear(DIRTY)
			share(players)
		end
	end

	local ticking: RBXScriptConnection? = nil
	local function startSharing()
		sharing, closing = true, false
		shareAt, refreshAt = 0, os.clock() + REFRESH_EVERY
		shareChanged = function(p: Player, record: any?)
			DIRTY[p] = true
			if globalHandlers[1] then
				tellGlobal((p :: any).UserId, if record then localEntry(p, record) else nil)
			end
		end
		for p in RECORDS do
			DIRTY[p] = true
		end
		ticking = RunService.Heartbeat:Connect(shareTick)
		task.spawn(function()
			local ok, connection = pcall(function()
				return game:GetService("MessagingService"):SubscribeAsync(TOPIC, received)
			end)
			if not ok then
				if IS_STUDIO then
					warn(`Branch anticheat: sharing across servers needs a published place: {connection}`)
				end
				return
			end
			if sharing then
				subscription = connection
				publish({ j = JOB, p = game.PlaceId, h = true })
			else
				connection:Disconnect()
			end
		end)
	end

	local function stopSharing()
		sharing = false
		shareChanged = nil
		if ticking then
			ticking:Disconnect()
			ticking = nil
		end
		if subscription then
			subscription:Disconnect()
			subscription = nil
		end
		-- the others forget this server's players
		closing = true
		local players = {}
		for p in RECORDS do
			table.insert(players, p)
		end
		share(players)
		closing = false
		table.clear(DIRTY)
		for key, held in GLOBAL do
			GLOBAL[key] = nil
			tellGlobal(held.entry.userId, nil)
		end
	end

	local closeBound = false

	local function clientOnly()
		error("Branch.Network.Anticheat.Check and Report are only available on the client", 2)
	end

	local function needsPlayer(player: any, name: string)
		if player == nil then
			error(`Branch.Network.Anticheat.{name}(player: Player, ...)`, 3)
		end
	end

	return table.freeze({
		-- every finding (not ignored): (player, check, detail, the player's score)
		OnFlag = function(handler: (player: Player, check: string, detail: string?, score: number) -> ()): () -> ()
			if type(handler) ~= "function" then
				error("Branch.Network.Anticheat.OnFlag(handler: (player, check, detail, score) -> ())", 2)
			end
			table.insert(flagHandlers, handler)
			return function()
				local index = table.find(flagHandlers, handler)
				if index then
					table.remove(flagHandlers, index)
				end
			end
		end,
		-- a player's record changed: (player, record), or (player, nil) when it is gone (pardoned, left)
		OnChanged = function(handler: (player: Player, record: any?) -> ()): () -> ()
			if type(handler) ~= "function" then
				error("Branch.Network.Anticheat.OnChanged(handler: (player, record?) -> ())", 2)
			end
			table.insert(changeHandlers, handler)
			return function()
				local index = table.find(changeHandlers, handler)
				if index then
					table.remove(changeHandlers, index)
				end
			end
		end,
		Flag = function(player: Player, check: string, detail: string?)
			if player == nil or type(check) ~= "string" or check == "" then
				error("Branch.Network.Anticheat.Flag(player: Player, check: string, detail: string?)", 2)
			end
			flag(player, check, if detail == nil then nil else tostring(detail))
		end,
		-- players in the server with a record, highest score first
		GetFlagged = function(): { any }
			local list = {}
			for p, record in RECORDS do
				table.insert(list, snapshot(p, record))
			end
			table.sort(list, function(a, b)
				return a.score > b.score
			end)
			return list
		end,
		GetRecord = function(player: Player): any?
			needsPlayer(player, "GetRecord")
			local record = RECORDS[player]
			return if record then snapshot(player, record) else nil
		end,
		-- forgives one check (its findings and their score) or everything (check nil)
		Pardon = function(player: Player, check: string?)
			needsPlayer(player, "Pardon")
			local record = RECORDS[player]
			if not record then
				return
			end
			local entry = if check ~= nil then record.checks[check] else nil
			if entry then
				decayed(record, os.clock())
				record.score = math_max(0, record.score - entry.count * (WEIGHTS[check :: string] or 1))
				record.checks[check :: string] = nil
				record.reached = 0
				for index, level in LEVELS do
					if record.score >= level.at then
						record.reached = index
					end
				end
			end
			if check == nil or next(record.checks) == nil then
				RECORDS[player] = nil
				RESTRICTED[player] = nil
				changed(player, nil)
			elseif entry then
				changed(player, record)
			end
		end,
		-- restricted: every request of theirs the server refuses counts as forged,
		-- and their rate limits refill at a quarter of the speed
		Restrict = function(player: Player, on: boolean?)
			needsPlayer(player, "Restrict")
			RESTRICTED[player] = if on == false then nil else true
			local record = RECORDS[player]
			if record then
				changed(player, record)
			end
		end,
		IsRestricted = function(player: Player): boolean
			return RESTRICTED[player] == true
		end,
		SetAction = function(check: string, action: "kick" | "report" | "ignore", after: number?)
			if
				type(check) ~= "string"
				or (action ~= "kick" and action ~= "report" and action ~= "ignore")
				or (after ~= nil and (type(after) ~= "number" or after < 1 or after % 1 ~= 0))
			then
				error('Branch.Network.Anticheat.SetAction(check: string, action: "kick" | "report" | "ignore", after: number? (kick from the n-th finding))', 2)
			end
			ACTIONS[check] = action
			AFTER[check] = after
		end,
		SetWeight = function(check: string, weight: number)
			if type(check) ~= "string" or type(weight) ~= "number" or weight < 0 then
				error("Branch.Network.Anticheat.SetWeight(check: string, weight: number (0 or more))", 2)
			end
			WEIGHTS[check] = weight
		end,
		-- at a score of `at`: "restrict", "kick" or your function (player, record); nil removes the level
		SetLevel = function(at: number, action: any)
			if type(at) ~= "number" or at <= 0 or (action ~= nil and action ~= "restrict" and action ~= "kick" and type(action) ~= "function") then
				error('Branch.Network.Anticheat.SetLevel(at: number, action: "restrict" | "kick" | (player, record) -> () | nil)', 2)
			end
			for index, level in LEVELS do
				if level.at == at then
					table.remove(LEVELS, index)
					break
				end
			end
			if action ~= nil then
				table.insert(LEVELS, { at = at, action = action })
				table.sort(LEVELS, function(a, b)
					return a.at < b.at
				end)
			end
		end,
		-- the score goes down by this many points a minute (0: never)
		SetDecay = function(perMinute: number)
			if type(perMinute) ~= "number" or perMinute < 0 then
				error("Branch.Network.Anticheat.SetDecay(perMinute: number (0 or more))", 2)
			end
			DECAY = perMinute
		end,
		-- "Basic" (the default): checks act on their own. "Advanced": checks only
		-- report and the score decides (restrict at 5, kick at 10, 1 point a
		-- minute forgotten). Later SetAction / SetLevel / SetDecay calls change it.
		Preset = function(name: "Basic" | "Advanced")
			if name == "Basic" then
				ACTIONS, AFTER, DEFAULT_ACTION, LEVELS, DECAY = table.clone(BASIC_ACTIONS), table.clone(BASIC_AFTER), "kick", {}, 0
			elseif name == "Advanced" then
				ACTIONS, AFTER, DEFAULT_ACTION, DECAY = {}, {}, "report", 1
				LEVELS = { { at = 5, action = "restrict" }, { at = 10, action = "kick" } }
			else
				error('Branch.Network.Anticheat.Preset(name: "Basic" | "Advanced")', 2)
			end
		end,
		SetKickMessage = function(message: string)
			if type(message) ~= "string" then
				error("Branch.Network.Anticheat.SetKickMessage(message: string)", 2)
			end
			kickMessage = message
		end,
		-- a ready-made check: "speed", "teleport", "fly", "noclip"; options change
		-- its numbers; false turns it off again
		Use = function(name: string, options: any)
			local defaults = MOVE_DEFAULTS[name]
			if not defaults or (options ~= nil and options ~= false and type(options) ~= "table") then
				error('Branch.Network.Anticheat.Use(name: "speed" | "teleport" | "fly" | "noclip", options: {}? | false)', 2)
			end
			if options == false then
				MOVE[name] = nil
				return
			end
			local merged = table.clone(defaults)
			for key, value in options or {} do
				if type(defaults[key]) ~= "number" or type(value) ~= "number" or value < 0 then
					error(`Branch.Network.Anticheat.Use("{name}"): unknown or bad option {key}`, 2)
				end
				merged[key] = value
			end
			MOVE[name] = merged
			startMoving()
		end,
		-- the game moves this player itself for a while (a dash, a launch pad, a
		-- cutscene): the ready-made checks leave them alone until then
		Pause = function(player: Player, seconds: number)
			needsPlayer(player, "Pause")
			if type(seconds) ~= "number" then
				error("Branch.Network.Anticheat.Pause(player: Player, seconds: number)", 2)
			end
			PAUSED[player] = math_max(PAUSED[player] or 0, os.clock() + seconds)
		end,
		-- the flagged players of every server of the game (MessagingService): turn on
		-- once on each server; false turns it off and the others forget this one
		ShareAcrossServers = function(on: boolean?)
			if on == false then
				if sharing then
					stopSharing()
				end
				return
			end
			if sharing then
				return
			end
			if not closeBound then
				closeBound = true
				game:BindToClose(function()
					if sharing then
						stopSharing()
						task.wait(0.5) -- let the last message go
					end
				end)
			end
			startSharing()
		end,
		-- this server's flagged players and the other servers', highest score first
		GetFlaggedGlobal = function(): { any }
			local list = {}
			for p, record in RECORDS do
				table.insert(list, localEntry(p, record))
			end
			for _, held in GLOBAL do
				table.insert(list, held.entry)
			end
			table.sort(list, function(a, b)
				return a.score > b.score
			end)
			return list
		end,
		-- an entry of any server changed: (userId, entry), or (userId, nil) when gone
		OnGlobalChanged = function(handler: (userId: number, entry: any?) -> ()): () -> ()
			if type(handler) ~= "function" then
				error("Branch.Network.Anticheat.OnGlobalChanged(handler: (userId, entry?) -> ())", 2)
			end
			table.insert(globalHandlers, handler)
			return function()
				local index = table.find(globalHandlers, handler)
				if index then
					table.remove(globalHandlers, index)
				end
			end
		end,
		Check = clientOnly,
		Report = clientOnly,
	})
end)()
-- Errors inside process: a decoder fault blames the packet, a Sync listener
-- fault is the game's own bug. `st` (one per packet) tells them apart:
-- { c after the event being dispatched (-1 while decoding), its ri,
--   events left in the current run, the run's reader }.
local function trace(message: any): { string }
	local text = tostring(message)
	return { text, debug.traceback(text, 2) }
end

local function process(player: Player, b: buffer, r: { any }, len: number, readers: { any }, runs: { any }, st: { any }, c: number, ri: number)
	-- finish a run that a throwing listener cut short
	local left = st[3]
	if left > 0 then
		local runner = st[5]
		if runner then
			c, ri = runner(player, b, c, r, ri, st, left)
			st[5] = false
		else
			local reader = st[4]
			for index = left - 1, 0, -1 do
				st[3] = index
				c, ri = reader(player, b, c, r, ri, st)
			end
		end
		st[3] = 0
	end
	while c < len do
		local id = buffer_readu8(b, c)
		c += 1
		if id == 0 then
			-- run: [0][id][count] then `count` bodies of the same event
			id = buffer_readu8(b, c)
			c += 1
			local count = buffer_readu8(b, c)
			c += 1
			if count >= 128 then
				count, c = rvar(b, c, count)
			end
			-- every event costs at least one byte, runs included, so a packet
			-- never dispatches more events than it has bytes
			local reader = readers[id]
			if reader == nil or count > len - c then
				error(`bad run of event {id}`, 0)
			end
			local bodies = c
			local runner = runs[id]
			if runner then
				st[5] = runner
				c, ri = runner(player, b, c, r, ri, st, count)
				st[5] = false
			else
				st[4] = reader
				for index = count - 1, 0, -1 do
					st[3] = index
					c, ri = reader(player, b, c, r, ri, st)
				end
			end
			st[3] = 0
			if c - bodies < count then
				error(`bad run of event {id}`, 0)
			end
		else
			local reader = readers[id]
			if reader == nil then
				error(`unknown event id {id}`, 0)
			end
			c, ri = reader(player, b, c, r, ri, st)
		end
	end
end

local function receiver(readers: { any }, runs: { any })
	return function(player: Player, b: any, r: any)
		if typeof(b) ~= "buffer" or (r ~= nil and type(r) ~= "table") then
			rejected(player, "wrong argument types", true)
			return
		end
		local len = buffer_len(b)
		if len == 0 or len > MAX_PACKET then
			-- empty: forged; too big: the game may just send a lot
			rejected(player, `packet size {len}`, len == 0)
			return
		end
		local refs = r or EMPTY
		local st = { -1, 0, 0, false, false }
		local c, ri = 0, 0
		while true do
			local ok, problem = xpcall(process, trace, player, b, refs, len, readers, runs, st, c, ri)
			if ok then
				return
			end
			c, ri = st[1], st[2]
			if c < 0 then
				rejected(player, problem[1], problem[1] ~= BAD)
				return
			end
			-- a Sync listener threw: report it like any script error, keep the rest
			st[1] = -1
			task.spawn(error, problem[2], 0)
		end
	end
end

local LS: { { (...any) -> () } } = table.create(4)
local ON: { (...any) -> () } = table.create(4)
local SPAWNS: { boolean } = {}
local Q: { { { n: number, [number]: any } } } = {}
local QWARNED: { boolean } = {}

-- Reused coroutine runner (spawning a fresh thread per event is the costly part).
local spawn: (fn: (...any) -> (), ...any) -> ()
do
	local freeThread: thread? = nil

	local function runHandler(fn: (...any) -> (), ...: any)
		local thread = freeThread
		freeThread = nil
		fn(...)
		freeThread = thread
	end

	local function runLoop()
		while true do
			runHandler(coroutine.yield())
		end
	end

	function spawn(fn: (...any) -> (), ...: any)
		if not freeThread then
			freeThread = coroutine.create(runLoop)
			coroutine.resume(freeThread :: thread)
		end
		task.spawn(freeThread :: thread, fn, ...)
	end
end

-- Keeps an event for the first listener; false when the queue is full.
local function enqueue(id: number, ...: any): boolean
	local queue = Q[id]
	if #queue >= QUEUE_LIMIT then
		if not QWARNED[id] then
			QWARNED[id] = true
			warn(`Branch.Network: {NAMES[id]} has no listener; dropping events past {QUEUE_LIMIT}`)
		end
		return false
	end
	queue[#queue + 1] = table.pack(...)
	return true
end

-- ON[id] is rebuilt whenever listeners change, so a received event costs one
-- index and one call: the lone Sync listener itself, a loop over a snapshot
-- (a listener that disconnects mid-event cannot skip its neighbour), a spawn
-- per listener for Async, or the queue while nobody listens.
local function rebuild(id: number)
	local listeners = table.clone(LS[id])
	local n = #listeners
	if n == 0 then
		ON[id] = function(...: any)
			enqueue(id, ...)
		end
	elseif SPAWNS[id] then
		ON[id] = function(...: any)
			for index = 1, n do
				spawn(listeners[index], ...)
			end
		end
	elseif n == 1 then
		ON[id] = listeners[1]
	else
		ON[id] = function(...: any)
			for index = 1, n do
				listeners[index](...)
			end
		end
	end
end

local function connect(id: number, fn: (...any) -> ()): () -> ()
	local listeners = LS[id]
	table.insert(listeners, fn)
	rebuild(id)
	local queue = Q[id]
	if #queue > 0 then
		Q[id] = {}
		for _, packed in queue do
			spawn(fn, table.unpack(packed, 1, packed.n))
		end
	end
	return function()
		local index = table.find(listeners, fn)
		if index then
			table.remove(listeners, index)
			rebuild(id)
		end
	end
end

local function failCall(id: number, player: Player, callId: number)
	local s = target(player, 1)
	if not s then
		return
	end
	openStream(s)
	local b, c = buf, cur
	if c + 5 > cap then
		b = grow(c, c + 5)
	end
	buffer_writeu8(b, c, RESPONSE_ID[id])
	buffer_writeu16(b, c + 1, callId)
	buffer_writeu8(b, c + 1 + 2, 0)
	cur = c + 1 + 3
	last = RESPONSE_ID[id]
	evn += 1
	evs[evn] = c
	closeStream(s)
	shipNow(s)
end

local function finish(id: number, player: Player, callId: number, ok: boolean, ...: any)
	if not ok then
		task.spawn(error, `Branch.Network: {NAMES[id]} handler errored: {tostring((...))}`, 0)
		failCall(id, player, callId)
	elseif not pcall(RESPOND[id], player, callId, ...) then
		task.spawn(error, `Branch.Network: {NAMES[id]} returned values that do not match its Return type`, 0)
		failCall(id, player, callId)
	end
end

local function call(id: number, player: Player, callId: number, handler: (...any) -> ...any, ...: any)
	finish(id, player, callId, pcall(handler, player, ...))
end

-- Readers (client -> server) --------------------------------------------

-- Bench.Booleans
LS[1] = {}
Q[1] = {}
NAMES[1] = "Bench.Booleans"
rebuild(1)
READ_R[1] = function(p: Player, b: buffer, c: number, r: { any }, ri: number, st: { any }): (number, number)
	local p0 = c
	local n_2 = buffer_readu8(b, c)
	c += 1
	if n_2 >= 128 then n_2, c = rvar(b, c, n_2) end
	if n_2 > 1000 then error(BAD, 0) end
	if (n_2 + 7) // 8 > buffer_len(b) - c then error(ERR, 0) end
	local arr_3 = table.create(n_2)
	local j_6 = 0
	if ROWS_WIN then
		for _ = 1, n_2 // 8 do
			table.move(BOOL_ROWS[buffer_readu8(b, c) + 1], 1, 8, j_6 + 1, arr_3)
			c += 1
			j_6 += 8
		end
	else
		for _ = 1, n_2 // 8 do
			local byte_5 = buffer_readu8(b, c)
			c += 1
			arr_3[j_6 + 1] = bit32_btest(byte_5, 1)
			arr_3[j_6 + 2] = bit32_btest(byte_5, 2)
			arr_3[j_6 + 3] = bit32_btest(byte_5, 4)
			arr_3[j_6 + 4] = bit32_btest(byte_5, 8)
			arr_3[j_6 + 5] = bit32_btest(byte_5, 16)
