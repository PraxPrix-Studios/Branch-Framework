				if IS_STUDIO then
					warn(`Branch anticheat: sharing across servers needs a published place: {connection}`)
				end
				if ticking then
					ticking:Disconnect()
					ticking = nil
				end
				return
			end
			if sharing then
				subscription = connection
				publish({ j = JOB, p = game.PlaceId, h = true })
			else
				connection:Disconnect()
			end
		end)
