				or (after ~= nil and (type(after) ~= "number" or after < 1 or after % 1 ~= 0))
			then
				error('Branch.Network.Anticheat.SetAction(check: string, action: "kick" | "report" | "ignore", after: number? (kick from the n-th finding))', 2)
			end
