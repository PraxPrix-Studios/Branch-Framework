--!strict
--!native
--!optimize 2
--!nolint LocalShadow
--!nolint LocalUnused
--!nolint FunctionUnused
-- Branch Network (server) - generated by Branch Studio bench
-- 6 events, 4 to server, 2 to client
-- DO NOT EDIT: this module is rewritten on every network compile.
-- Declare events in your services: Service.Network = { Event = { From = ..., Data = ... } }
local bit32_btest = bit32.btest
local buffer_copy = buffer.copy
local buffer_create = buffer.create
local buffer_len = buffer.len
local buffer_readf64 = buffer.readf64
local buffer_readstring = buffer.readstring
local buffer_readu16 = buffer.readu16
local buffer_readu8 = buffer.readu8
local buffer_writef32 = buffer.writef32
local buffer_writeu16 = buffer.writeu16
local buffer_writeu8 = buffer.writeu8
local math_max = math.max

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- This module lives in ServerScriptService, so players never download it.
-- Root is Branch.Network in ReplicatedStorage, where the remotes are.
local rootRef = (script :: any):FindFirstChild("Root")
local Root: any = if rootRef then rootRef.Value else script.Parent
local Reliable = Root:WaitForChild("Reliable") :: RemoteEvent
local Unreliable = Root:WaitForChild("Unreliable") :: UnreliableRemoteEvent

local CHECK = false
local IS_STUDIO = RunService:IsStudio()
local BUDGET = 820
local MAX_PACKET = 65536
local QUEUE_LIMIT = 256
local INF = math.huge
local NAMES: { string } = {}
local RESPONSE_ID: { number } = {}
local READ_R: { any } = {}
local READ_U: { any } = {}
local HANDLERS: { any } = {}
local RESPOND: { any } = {}
local DSEND: { any } = {} -- Delta: per event, per player, what they hold
local DRECV: { any } = {} -- Delta: per event, per player, what they sent last
local WRITE: { any } = {}
local WRITEALL: { any } = {}
local STORE: { any } = {} -- Latest: keep the newest arguments until the flush
local LPA: { any } = {}
local LPS: { any } = {}
local LAA: { any } = {}
local LAS: { any } = {}
local LPK: { any } = {} -- Latest with Key: per player, the keys waiting for the flush
local GATE: { any } = {} -- Hz / Lod: seconds between sends, per ring
local GDUE: { any } = {}
local LOD: { any } = {} -- Lod: ring distances

local PROFILE = false -- built without the Studio profiler
local SNAMES: { string } = {}
local PS_COUNT: { [number]: number } = {}
local PS_BYTES: { [number]: number } = {}
local PR_COUNT: { [number]: number } = {}
local PR_BYTES: { [number]: number } = {}
local PNUM: { [string]: { number } } = {}

local function psent(id: number, bytes: number)
	PS_COUNT[id] = (PS_COUNT[id] or 0) + 1
	PS_BYTES[id] = (PS_BYTES[id] or 0) + bytes
end

local function precv(id: number, bytes: number)
	PR_COUNT[id] = (PR_COUNT[id] or 0) + 1
	PR_BYTES[id] = (PR_BYTES[id] or 0) + bytes
end

local function pnum(id: number, field: string, v: any, declared: string, names: { string }?)
	if type(v) ~= "number" or v ~= v then
		return
	end
	local k = ((names or SNAMES)[id] or "?") .. "|" .. field
	local s = PNUM[k]
	if not s then
		PNUM[k] = { v, v, if v % 1 == 0 then 1 else 0, declared :: any }
		return
	end
	if v < s[1] then s[1] = v end
	if v > s[2] then s[2] = v end
	if v % 1 ~= 0 then s[3] = 0 end
end

local lastPublish = -1
local function publish()
	local now = os.clock()
	if now - lastPublish < 1 then
		return
	end
	lastPublish = now
	local out = {}
	for id, n in PS_COUNT do
		out[#out + 1] = `S|{SNAMES[id] or "?"}|{n}|{PS_BYTES[id]}`
	end
	for id, n in PR_COUNT do
		out[#out + 1] = `R|{NAMES[id] or "?"}|{n}|{PR_BYTES[id]}`
	end
	for k, s in PNUM do
		out[#out + 1] = `N|{k}|{s[1]}|{s[2]}|{s[3]}|{s[4]}`
	end
	(Root :: any):SetAttribute("BranchNetStatsServer", table.concat(out, "\n"))
end

if PROFILE and (Root :: any).SetAttribute ~= nil then
	RunService.Heartbeat:Connect(publish)
end

-- FireNear: players whose character's PrimaryPart is within `radius`.
local nearList: { Player } = {}
local function near(position: Vector3, radius: number): { Player }
	table.clear(nearList)
	for _, player in Players:GetPlayers() do
		local character = (player :: any).Character
		local root = character and character.PrimaryPart
		if root and (root.Position - position).Magnitude <= radius then
			nearList[#nearList + 1] = player
		end
	end
	return nearList
end

local function rvar(b: buffer, c: number, first: number): (number, number)
	local value = first - 128
	local scale = 128
	for _ = 1, 4 do
		local byte = buffer_readu8(b, c)
		c += 1
		if byte < 128 then
			return value + byte * scale, c
		end
		value += (byte - 128) * scale
		scale *= 128
	end
	error("varint too long", 0)
end

-- Send state: the stream currently being written.
local buf: buffer = buffer_create(0)
local cap = 0
local cur = 0
local refs: { any } = {}
local refn = 0
local evs: { number } = {} -- start of every event in the stream; negative = a run repeat
local evn = 0
local last = 0 -- id of the stream's last event (0: none); the same id next continues a run

-- Per-stream storage (Structure of Arrays). Player slot k owns stream
-- 2k - 1 (reliable) and 2k (unreliable).
local sBuf: { buffer } = {}
local sCap: { number } = {}
local sCur: { number } = {}
local sRefs: { { any } } = {}
local sRefn: { number } = {}
local sEvs: { { number } } = {}
local sEvn: { number } = {}
local sLast: { number } = {}
local sExtra: { number } = {} -- unreliable: bytes packing will add (for the budget)
local sRun: { number } = {} -- unreliable: length of the trailing run
local sDirty: { boolean } = {}
local slotPlayer: { Player } = {}
local slotOf: { [Player]: number } = {}
local freeSlots: { number } = {}
local slotCount = 0
local dirty: { number } = {}
local dirtyCount = 0

-- Scratch for FireList / FireExcept: serialised once, copied to each recipient.
local xBuf = buffer_create(256)
local xCap = 256
local xRefs: { any } = {}
local xEvs: { number } = {}

local function grow(c: number, need: number): buffer
	local size = math_max(cap * 2, 256)
	while size < need do
		size *= 2
	end
	local b = buffer_create(size)
	buffer_copy(b, 0, buf, 0, c)
	buf = b
	cap = size
	return b
end

-- Runs: the writer stores a repeat of the previous event without its id (a
-- negative start marks one), so a run sits in the stream as [id][body][body]..
-- Shipping puts [0] and the count in front, [0][id][count][bodies]: one copy
-- per run. Runs shorter than 3, or whose bodies hold less than a byte per
-- event (the receiver's DoS bound: argument-less events), get their ids back.
-- Pass 1 sizes the output exactly, pass 2 writes it: one allocation, and a
-- frame without repeats is a single copy.
local runFrom: { number } = {}
local runTo: { number } = {}
local runHead: { boolean } = {}

local function pack(src: buffer, n: number, starts: { number }, count: number): buffer
	local runs = 0
	local size = n
	local i = 1
	while i <= count do
		local j = i
		while j < count and starts[j + 1] < 0 do
			j += 1
		end
		if j > i then
			local length = j - i + 1
			local stop = if j < count then starts[j + 1] else n
			local head = length >= 3 and stop - starts[i] >= 1 + length
			runs += 1
			runFrom[runs] = i
			runTo[runs] = j
			runHead[runs] = head
			if head then
				size += 1 + (if length < 128 then 1 elseif length < 16384 then 2 elseif length < 2097152 then 3 else 4)
			else
				size += (length - 1) * 1
			end
		end
		i = j + 1
	end
	local out = buffer_create(size)
	if runs == 0 then
		buffer_copy(out, 0, src, 0, n)
		return out
	end
	local o = 0
	local pending = 0
	for r = 1, runs do
		local from, to = runFrom[r], runTo[r]
		local first = starts[from]
		local stop = if to < count then starts[to + 1] else n
		if runHead[r] then
			if first > pending then
				buffer_copy(out, o, src, pending, first - pending)
				o += first - pending
			end
			buffer_writeu8(out, o, 0)
			buffer_writeu8(out, o + 1, buffer_readu8(src, first))
			o += 2 * 1
			local v = to - from + 1
			while v >= 128 do
				buffer_writeu8(out, o, v % 128 + 128)
				v //= 128
				o += 1
			end
			buffer_writeu8(out, o, v)
			o += 1
			local bodies = first + 1
			buffer_copy(out, o, src, bodies, stop - bodies)
			o += stop - bodies
		else
			local repeat1 = -starts[from + 1]
			if repeat1 > pending then
				buffer_copy(out, o, src, pending, repeat1 - pending)
				o += repeat1 - pending
			end
			local id = buffer_readu8(src, first)
			for k = from + 1, to do
				local bodyStart = -starts[k]
				local bodyEnd = if k < to then -starts[k + 1] else stop
				buffer_writeu8(out, o, id)
				o += 1
				if bodyEnd > bodyStart then
					buffer_copy(out, o, src, bodyStart, bodyEnd - bodyStart)
					o += bodyEnd - bodyStart
				end
			end
		end
		pending = stop
	end
	if pending < n then
		buffer_copy(out, o, src, pending, n - pending)
	end
	return out
end

-- Bytes packing adds back when a run grows to `length` events: its 2nd event
-- gets its id back (a run of 2 ships as two plain events), the 3rd turns it
-- into [0][id][count] (+1 for the count), and the count's varint grows.
local function runGrowth(length: number): number
	return if length == 2 then 1 elseif length == 3 or length == 128 or length == 16384 then 1 else 0
end

-- Moves the tail (events from index `first`, from byte `start`) to the front
-- once what came before it has shipped; refs and event starts follow. A tail
-- that repeats the event before it gets its id back: its run head is gone.
local function keepTail(start: number, refStart: number, first: number)
	local shift = start
	if evs[first] < 0 then
		local k = first - 1
		while evs[k] < 0 do
			k -= 1
		end
		local id = buffer_readu8(buf, evs[k])
		buffer_copy(buf, 1, buf, start, cur - start)
		buffer_writeu8(buf, 0, id)
		shift -= 1
	else
		buffer_copy(buf, 0, buf, start, cur - start)
	end
	cur -= shift
	if refStart > 0 then
		local remaining = refn - refStart
		table.move(refs, refStart + 1, refn, 1)
		for index = remaining + 1, refn do
			refs[index] = nil
		end
		refn = remaining
	end
	evs[1] = 0
	local count = 1
	for k = first + 1, evn do
		local e = evs[k]
		count += 1
		evs[count] = if e < 0 then e + shift else e - shift
	end
	evn = count
end

local function slot(player: Player): number?
	local k = slotOf[player]
	if k then
		return k
	end
	if player.Parent ~= Players then
		return nil
	end
	k = table.remove(freeSlots)
	if not k then
		slotCount += 1
		k = slotCount
		for s = 2 * k - 1, 2 * k do
			sBuf[s] = buffer_create(256)
			sCap[s] = 256
			sCur[s] = 0
			sRefs[s] = {}
			sRefn[s] = 0
			sEvs[s] = {}
			sEvn[s] = 0
			sLast[s] = 0
			sExtra[s] = 0
			sRun[s] = 0
			sDirty[s] = false
		end
	end
	slotOf[player] = k
	slotPlayer[k] = player
	return k
end

-- FireAll arenas: while only FireAll writes to a channel, its events pile up
-- here once and ship as ONE FireAllClients per frame (serialised once, one
-- engine call). The first per-player write on that channel "materialises"
-- the arena into every recipient's stream, so per-player order is exact.
local bBuf: { buffer } = { buffer_create(256), buffer_create(256) }
local bCap: { number } = { 256, 256 }
local bCur: { number } = { 0, 0 }
local bRefs: { { any } } = { {}, {} }
local bRefn: { number } = { 0, 0 }
local bEvs: { { number } } = { {}, {} }
local bEvn: { number } = { 0, 0 }
local bLast: { number } = { 0, 0 }
local aExtra, aRun = 0, 0 -- the unreliable arena's budget bookkeeping (like sExtra / sRun)
local bPlayers: { { Player } } = { {}, {} } -- recipients at the first FireAll of the batch
local bRoster: { number } = { 0, 0 }
local roster = 0 -- bumps on every join/leave

-- Write-back cache: the stream being written stays in the upvalues above
-- until another stream is opened (or the frame flushes), so consecutive
-- fires to one player, or consecutive FireAlls, cost a single comparison
-- instead of a dozen table ops. openS > 0 is a player stream, -c the FireAll
-- arena of channel c, 0 nothing.
local openS = 0

local function writeBack()
	local s = openS
	if s > 0 then
		sBuf[s], sCap[s], sCur[s], sRefn[s], sEvn[s], sLast[s] = buf, cap, cur, refn, evn, last
	elseif s < 0 then
		s = -s
		bBuf[s], bCap[s], bCur[s], bRefn[s], bEvn[s], bLast[s] = buf, cap, cur, refn, evn, last
	end
	openS = 0
end

local function openStream(s: number)
	if s ~= openS then
		writeBack()
		buf, cap, cur, refs, refn, evs, evn, last = sBuf[s], sCap[s], sCur[s], sRefs[s], sRefn[s], sEvs[s], sEvn[s], sLast[s]
		openS = s
	end
end

local function closeStream(s: number)
	if not sDirty[s] then
		sDirty[s] = true
		dirtyCount += 1
		dirty[dirtyCount] = s
	end
end

local function openScratch()
	writeBack()
	buf, cap, cur, refs, refn, evs, evn, last = xBuf, xCap, 0, xRefs, 0, xEvs, 0, 0
end

local function closeScratch(): (buffer, number, number, number)
	xBuf, xCap = buf, cap
	return buf, cur, refn, last
end

local function headRefs(refStart: number): { any }?
	return if refStart > 0 then table.move(refs, 1, refStart, 1, table.create(refStart)) else nil
end

-- Unreliable packets above the budget are dropped by Roblox, so an event that
-- would overflow the pending batch ships the batch first.
-- The budget counts what packing adds back to runs, so no packet goes over.
local function closeUnreliable(s: number, start: number, refStart: number)
	local run = if evs[evn] < 0 then sRun[s] + 1 else 1
	local extra = sExtra[s] + (if run > 1 then runGrowth(run) else 0)
	if start > 0 and cur + extra + refn * 8 > BUDGET then
		Unreliable:FireClient(slotPlayer[(s + 1) // 2], pack(buf, start, evs, evn - 1), headRefs(refStart))
		keepTail(start, refStart, evn)
		run, extra = 1, 0
	end
	sRun[s], sExtra[s] = run, extra
	closeStream(s)
end

-- Copies a serialised block (an arena, or one FireList event) into stream s.
-- The block opens with a full event; on a reliable stream whose last event is
-- the same one, that id is dropped so the run carries on across the join.
-- Unreliable blocks stay whole (their budget bookkeeping travels with them).
local function append(s: number, src: buffer, n: number, srcRefs: { any }, srcRefn: number, srcEvs: { number }, srcEvn: number, srcLast: number, srcExtra: number, srcRun: number)
	openStream(s)
	local unreliable = s % 2 == 0
	local start, refStart, first = cur, refn, evn + 1
	local skip = if not unreliable and last ~= 0 and buffer_readu8(src, 0) == last then 1 else 0
	local c = cur
	if c + n - skip > cap then
		grow(c, c + n - skip)
	end
	buffer_copy(buf, c, src, skip, n - skip)
	cur = c + n - skip
	if srcRefn > 0 then
		table.move(srcRefs, 1, srcRefn, refn + 1, refs)
		refn += srcRefn
	end
	local shift = c - skip
	evn += 1
	evs[evn] = if skip > 0 then -c else c
	for index = 2, srcEvn do
		local e = srcEvs[index]
		evn += 1
		evs[evn] = if e < 0 then e - shift else e + shift
	end
	last = srcLast
	if unreliable then
		local extra = sExtra[s] + srcExtra
		if start > 0 and cur + extra + refn * 8 > BUDGET then
			Unreliable:FireClient(slotPlayer[(s + 1) // 2], pack(buf, start, evs, first - 1), headRefs(refStart))
			keepTail(start, refStart, first)
			extra = srcExtra
		end
		sExtra[s], sRun[s] = extra, srcRun
	end
	closeStream(s)
end

local function materialize(c: number)
	local n, rn, en, srcLast = bCur[c], bRefn[c], bEvn[c], bLast[c]
	bCur[c], bRefn[c], bEvn[c], bLast[c] = 0, 0, 0, 0
	local srcExtra, srcRun = 0, 0
	if c == 2 then
		srcExtra, srcRun, aExtra, aRun = aExtra, aRun, 0, 0
	end
	local src, srcRefs, srcEvs = bBuf[c], bRefs[c], bEvs[c]
	for _, player in bPlayers[c] do
		local k = slotOf[player] or slot(player)
		if k then
			append(2 * k - 2 + c, src, n, srcRefs, rn, srcEvs, en, srcLast, srcExtra, srcRun)
		end
	end
	if rn > 0 then
		table.clear(srcRefs)
	end
end

-- Stream index for a per-player write on channel c (1 reliable, 2 unreliable).
local function target(player: Player, c: number): number?
	if openS < 0 then
		writeBack()
	end
	if bCur[c] > 0 then
		materialize(c)
	end
	local k = slotOf[player] or slot(player)
	if not k then
		return nil
	end
	return 2 * k - 2 + c
end

local function openBroadcast(c: number)
	if openS ~= -c then
		writeBack()
		buf, cap, cur, refs, refn, evs, evn, last = bBuf[c], bCap[c], bCur[c], bRefs[c], bRefn[c], bEvs[c], bEvn[c], bLast[c]
		openS = -c
	end
	if cur == 0 then
		bPlayers[c] = Players:GetPlayers()
		bRoster[c] = roster
	end
end

local function shipBroadcast(c: number, out: buffer, r: { any }?)
	local remote: any = if c == 1 then Reliable else Unreliable
	if bRoster[c] == roster then
		remote:FireAllClients(out, r)
	else
		-- someone joined or left since the first FireAll: keep exact recipients
		for _, player in bPlayers[c] do
			if player.Parent == Players then
				remote:FireClient(player, out, r)
			end
		end
	end
end

local function broadcast(src: buffer, n: number, rn: number, srcLast: number, offset: number, players: { Player }, except: Player?)
	local c = 2 - offset
	if openS < 0 then
		writeBack()
	end
	if bCur[c] > 0 then
		materialize(c)
	end
	for _, player in players do
		if player ~= except then
			local k = slotOf[player] or slot(player)
			if k then
				append(2 * k - offset, src, n, xRefs, rn, xEvs, 1, srcLast, 0, 1)
			end
		end
	end
	if rn > 0 then
		table.clear(xRefs)
	end
end

-- Ships one stream now (end of frame, or right away for function replies).
local function ship(s: number)
	local n = sCur[s]
	if n == 0 then
		return
	end
	local rn = sRefn[s]
	local out = pack(sBuf[s], n, sEvs[s], sEvn[s])
	local player = slotPlayer[(s + 1) // 2]
	if s % 2 == 1 then
		Reliable:FireClient(player, out, if rn > 0 then sRefs[s] else nil)
	else
		Unreliable:FireClient(player, out, if rn > 0 then sRefs[s] else nil)
	end
	sCur[s] = 0
	sEvn[s] = 0
	sLast[s] = 0
	sExtra[s] = 0
	sRun[s] = 0
	if rn > 0 then
		table.clear(sRefs[s])
		sRefn[s] = 0
	end
	-- Give back memory after a burst.
	if sCap[s] > 65536 and n < 8192 then
		sBuf[s] = buffer_create(8192)
		sCap[s] = 8192
	end
end

local function shipNow(s: number)
	writeBack()
	ship(s)
end

-- Only the unreliable arena needs closing: it ships early before the budget.
-- Unreliable events queued for single players before this FireAll go first,
-- or the early ship would overtake them.
local function closeBroadcast(start: number, refStart: number)
	local run = if evs[evn] < 0 then aRun + 1 else 1
	local extra = aExtra + (if run > 1 then runGrowth(run) else 0)
	if start > 0 and cur + extra + refn * 8 > BUDGET then
		for index = 1, dirtyCount do
			local s = dirty[index]
			if s % 2 == 0 then
				ship(s)
			end
		end
		shipBroadcast(2, pack(buf, start, evs, evn - 1), headRefs(refStart))
		keepTail(start, refStart, evn)
		run, extra = 1, 0
	end
	aRun, aExtra = run, extra
end

-- Latest events write their newest values here, just before the frame ships.
local PRE_FLUSH: { () -> () } = {}

local function flush()
	for index = 1, #PRE_FLUSH do
		PRE_FLUSH[index]()
	end
	writeBack()
	for index = 1, dirtyCount do
		local s = dirty[index]
		sDirty[s] = false
		ship(s)
	end
	dirtyCount = 0
	-- FireAll arenas go last: they only hold events fired after every
	-- per-player event already flushed above.
	for c = 1, 2 do
		local n = bCur[c]
		if n > 0 then
			local rn = bRefn[c]
			shipBroadcast(c, pack(bBuf[c], n, bEvs[c], bEvn[c]), if rn > 0 then bRefs[c] else nil)
			bCur[c] = 0
			bEvn[c] = 0
			bLast[c] = 0
			if c == 2 then
				aExtra, aRun = 0, 0
			end
			if rn > 0 then
				table.clear(bRefs[c])
				bRefn[c] = 0
			end
			if bCap[c] > 65536 and n < 8192 then
				bBuf[c] = buffer_create(8192)
				bCap[c] = 8192
			end
		end
	end
end

Players.PlayerAdded:Connect(function()
	roster += 1
end)

Players.PlayerRemoving:Connect(function(player: Player)
	roster += 1
	local k = slotOf[player]
	if not k then
		return
	end
	if openS == 2 * k - 1 or openS == 2 * k then
		openS = 0 -- discard: nothing more goes to this player
	end
	slotOf[player] = nil
	for s = 2 * k - 1, 2 * k do
		sCur[s] = 0
		sRefn[s] = 0
		sEvn[s] = 0
		sLast[s] = 0
		sExtra[s] = 0
		sRun[s] = 0
		table.clear(sRefs[s])
	end
	table.insert(freeSlots, k)
end)

RunService.Heartbeat:Connect(flush)

-- Receive -----------------------------------------------------------------

local EMPTY = table.freeze({})
local ERR = "malformed packet"
local rejectHandlers: { (Player, string) -> () } = {}

local function rejected(player: Player, reason: any)
	local text = tostring(reason)
	if IS_STUDIO then
		warn(`Branch.Network rejected a packet from {player.Name}: {text}`)
	end
	for _, handler in rejectHandlers do
		task.spawn(handler, player, text)
	end
end

-- Errors inside process: a decoder fault blames the packet, a Sync listener
-- fault is the game's own bug. `st` (one per packet) tells them apart:
-- { c after the event being dispatched (-1 while decoding), its ri,
--   events left in the current run, the run's reader }.
local function trace(message: any): { string }
	local text = tostring(message)
	return { text, debug.traceback(text, 2) }
end

local function process(player: Player, b: buffer, r: { any }, len: number, readers: { any }, st: { any }, c: number, ri: number)
	-- finish a run that a throwing listener cut short
	local left = st[3]
	if left > 0 then
		local reader = st[4]
		for index = left - 1, 0, -1 do
			st[3] = index
			c, ri = reader(player, b, c, r, ri, st)
		end
		st[3] = 0
	end
	while c < len do
		local id = buffer_readu8(b, c)
		c += 1
		if id == 0 then
			-- run: [0][id][count] then `count` bodies of the same event
			id = buffer_readu8(b, c)
			c += 1
			local count = buffer_readu8(b, c)
			c += 1
			if count >= 128 then
				count, c = rvar(b, c, count)
			end
			-- every event costs at least one byte, runs included, so a packet
			-- never dispatches more events than it has bytes
			local reader = readers[id]
			if reader == nil or count > len - c then
				error(`bad run of event {id}`, 0)
			end
			local bodies = c
			st[4] = reader
			for index = count - 1, 0, -1 do
				st[3] = index
				c, ri = reader(player, b, c, r, ri, st)
			end
			st[3] = 0
			if c - bodies < count then
				error(`bad run of event {id}`, 0)
			end
		else
			local reader = readers[id]
			if reader == nil then
				error(`unknown event id {id}`, 0)
			end
			c, ri = reader(player, b, c, r, ri, st)
		end
	end
end

local function receiver(readers: { any })
	return function(player: Player, b: any, r: any)
		if typeof(b) ~= "buffer" or (r ~= nil and type(r) ~= "table") then
			rejected(player, "wrong argument types")
			return
		end
		local len = buffer_len(b)
		if len == 0 or len > MAX_PACKET then
			rejected(player, `packet size {len}`)
			return
		end
		local refs = r or EMPTY
		local st = { -1, 0, 0, false }
		local c, ri = 0, 0
		while true do
			local ok, problem = xpcall(process, trace, player, b, refs, len, readers, st, c, ri)
			if ok then
				return
			end
			c, ri = st[1], st[2]
			if c < 0 then
				rejected(player, problem[1])
				return
			end
			-- a Sync listener threw: report it like any script error, keep the rest
			st[1] = -1
			task.spawn(error, problem[2], 0)
		end
	end
end

local LS: { { (...any) -> () } } = {}
local ON: { (...any) -> () } = {}
local SPAWNS: { boolean } = {}
local Q: { { { n: number, [number]: any } } } = {}
local QWARNED: { boolean } = {}

-- Reused coroutine runner (spawning a fresh thread per event is the costly part).
local freeThread: thread? = nil

local function runHandler(fn: (...any) -> (), ...: any)
	local thread = freeThread
	freeThread = nil
	fn(...)
	freeThread = thread
end

local function runLoop()
	while true do
		runHandler(coroutine.yield())
	end
end

local function spawn(fn: (...any) -> (), ...: any)
	if not freeThread then
		freeThread = coroutine.create(runLoop)
		coroutine.resume(freeThread :: thread)
	end
	task.spawn(freeThread :: thread, fn, ...)
end

-- Keeps an event for the first listener; false when the queue is full.
local function enqueue(id: number, ...: any): boolean
	local queue = Q[id]
	if #queue >= QUEUE_LIMIT then
		if not QWARNED[id] then
			QWARNED[id] = true
			warn(`Branch.Network: {NAMES[id]} has no listener; dropping events past {QUEUE_LIMIT}`)
		end
		return false
	end
	queue[#queue + 1] = table.pack(...)
	return true
end

-- ON[id] is rebuilt whenever listeners change, so a received event costs one
-- index and one call: the lone Sync listener itself, a loop over a snapshot
-- (a listener that disconnects mid-event cannot skip its neighbour), a spawn
-- per listener for Async, or the queue while nobody listens.
local function rebuild(id: number)
	local listeners = table.clone(LS[id])
	local n = #listeners
	if n == 0 then
		ON[id] = function(...: any)
			enqueue(id, ...)
		end
	elseif SPAWNS[id] then
		ON[id] = function(...: any)
			for index = 1, n do
				spawn(listeners[index], ...)
			end
		end
	elseif n == 1 then
		ON[id] = listeners[1]
	else
		ON[id] = function(...: any)
			for index = 1, n do
				listeners[index](...)
			end
		end
	end
end

local function connect(id: number, fn: (...any) -> ()): () -> ()
	local listeners = LS[id]
	table.insert(listeners, fn)
	rebuild(id)
	local queue = Q[id]
	if #queue > 0 then
		Q[id] = {}
		for _, packed in queue do
			spawn(fn, table.unpack(packed, 1, packed.n))
		end
	end
	return function()
		local index = table.find(listeners, fn)
		if index then
			table.remove(listeners, index)
			rebuild(id)
		end
	end
end

local function failCall(id: number, player: Player, callId: number)
	local s = target(player, 1)
	if not s then
		return
	end
	openStream(s)
	local b, c = buf, cur
	if c + 5 > cap then
		b = grow(c, c + 5)
	end
	buffer_writeu8(b, c, RESPONSE_ID[id])
	buffer_writeu16(b, c + 1, callId)
	buffer_writeu8(b, c + 1 + 2, 0)
	cur = c + 1 + 3
	last = RESPONSE_ID[id]
	evn += 1
	evs[evn] = c
	closeStream(s)
	shipNow(s)
end

local function finish(id: number, player: Player, callId: number, ok: boolean, ...: any)
	if not ok then
		task.spawn(error, `Branch.Network: {NAMES[id]} handler errored: {tostring((...))}`, 0)
		failCall(id, player, callId)
	elseif not pcall(RESPOND[id], player, callId, ...) then
		task.spawn(error, `Branch.Network: {NAMES[id]} returned values that do not match its Return type`, 0)
		failCall(id, player, callId)
	end
end

local function call(id: number, player: Player, callId: number, handler: (...any) -> ...any, ...: any)
	finish(id, player, callId, pcall(handler, player, ...))
end

