-- API ------------------------------------------------------------------

local Services = {
	Bench = table.freeze({
		Booleans = table.freeze({
			Fire = function(a1: { boolean })
				openStream(1)
				local b, c, rn, c0 = buf, cur, refn, cur
				local more = last == 1
				if c + 1 > cap then b = grow(c, c + 1) end
				if more then c -= 1 else buffer_writeu8(b, c, 1) end
				c += 1
				local arr17 = a1
				local n18 = #arr17
				if c + 5 + (n18 + 7) // 8 > cap then b = grow(c, c + 5 + (n18 + 7) // 8) end
				local v24 = n18
				while v24 >= 128 do
					buffer_writeu8(b, c, v24 % 128 + 128)
					v24 //= 128
					c += 1
				end
				buffer_writeu8(b, c, v24)
				c += 1
				local full22 = n18 // 8
				local j21 = 0
				for _ = 1, full22 do
					buffer_writeu8(b, c, (if arr17[j21 + 1] then 1 else 0) + (if arr17[j21 + 2] then 2 else 0) + (if arr17[j21 + 3] then 4 else 0) + (if arr17[j21 + 4] then 8 else 0) + (if arr17[j21 + 5] then 16 else 0) + (if arr17[j21 + 6] then 32 else 0) + (if arr17[j21 + 7] then 64 else 0) + (if arr17[j21 + 8] then 128 else 0))
					c += 1
					j21 += 8
				end
				local rest23 = n18 - j21
				if rest23 > 0 then
					local byte20 = 0
					for i19 = 1, rest23 do
						if arr17[j21 + i19] then byte20 += 2 ^ (i19 - 1) end
					end
					buffer_writeu8(b, c, byte20)
					c += 1
				end
				cur, refn, last = c, rn, 1
				evn += 1
				evs[evn] = if more then -c0 else c0
				if PROFILE then psent(1, c - c0) end
				closeStream(1)
			end :: (value: { boolean }) -> (),
		}),
		Cars = table.freeze({
			Fire = function(a1: string, a2: string, a3: number, a4: boolean, a5: number, a6: number)
				if PROFILE then pnum(2, "carId", a3, "u16"); pnum(2, "dealers", a5, "u8"); pnum(2, "price", a6, "f64") end
				openStream(1)
				local b, c, rn, c0 = buf, cur, refn, cur
				local more = last == 2
